---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  ogType?: string;
}

const {
  title = 'FreeTrustDocs — Free Trust Document Generator',
  description = 'Generate professional trust documents for free. Certificate of Trust, Declaration of Trust, Land Trust. No signup. Nothing leaves your browser.',
  ogType = 'website',
} = Astro.props;

const fullTitle = title.includes('FreeTrustDocs') ? title : `${title} — FreeTrustDocs`;
const canonical = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={`https://freetrustdocs.com${canonical}`} />

  <!-- Open Graph -->
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="FreeTrustDocs" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Crimson+Pro:wght@400;500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- UPL: not a law firm -->
  <meta name="robots" content={ogType === 'article' ? 'index, follow' : 'index, follow'} />
</head>
<body>
  <!-- Header -->
  <header class="site-header">
    <div class="container">
      <a href="/" class="site-logo">
        <img src="/images/logo/logo-mark-white.svg" alt="FreeTrustDocs" width="48" height="48" class="logo-mark" />
        <span class="logo-text">Free<span class="logo-doc">Trust</span>Docs</span>
      </a>
      <nav class="site-nav">
        <a href="/certificate-of-trust/">Certificate of Trust</a>
        <a href="/declaration-of-trust/">Declaration of Trust</a>
        <a href="/land-trust/">Land Trust</a>
        <a href="/best-states-for-trusts/">Best States</a>
        <a href="/legal/disclaimer/">Disclaimer</a>
      </nav>
    </div>
  </header>

  <!-- Main content -->
  <main>
    <slot />
  </main>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <div>
          <div class="site-logo" style="margin-bottom: 0.5rem;">
            <img src="/images/logo/logo-mark-white.svg" alt="FreeTrustDocs" width="44" height="44" class="logo-mark" />
            <span class="logo-text">Free<span style="color: var(--color-accent-light);">Trust</span>Docs</span>
          </div>
          <p style="font-size: 0.9rem; color: rgba(248,245,239,0.7); max-width: 300px;">
            Free, private trust document generation. Nothing leaves your browser.
          </p>
        </div>
        <div class="footer-col">
          <h5>Documents</h5>
          <ul>
            <li><a href="/certificate-of-trust/">Certificate of Trust</a></li>
            <li><a href="/declaration-of-trust/">Declaration of Trust</a></li>
            <li><a href="/land-trust/">Land Trust</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h5>Resources</h5>
          <ul>
            <li><a href="/best-states-for-trusts/">Best States for Trusts</a></li>
            <li><a href="/certificate-of-trust/all-states/">All State Guide</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h5>Legal</h5>
          <ul>
            <li><a href="/legal/disclaimer/">Disclaimer</a></li>
            <li><a href="/legal/terms/">Terms of Use</a></li>
            <li><a href="/legal/privacy/">Privacy</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-disclaimer">
        <strong>FreeTrustDocs.com is not a law firm and does not provide legal advice.</strong>
        The documents generated by this site are for informational purposes only and do not constitute legal advice.
        You should consult a licensed attorney in your jurisdiction before signing or filing any legal document.
        Use of this site does not create an attorney-client relationship.
      </div>
    </div>
  </footer>

  <!-- GA4 (add when deployed) -->
</body>
</html>