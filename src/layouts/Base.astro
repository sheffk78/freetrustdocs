---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  ogType?: string;
}

const {
  title = 'FreeTrustDocs — Free Trust Document Generator',
  description = 'Generate professional trust documents for free. Certificate of Trust, Declaration of Trust, Land Trust. No signup. Nothing leaves your browser.',
  ogType = 'website',
} = Astro.props;

const fullTitle = title.includes('FreeTrustDocs') ? title : `${title} — FreeTrustDocs`;
const canonical = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={`https://freetrustdocs.com${canonical}`} />

  <!-- Open Graph -->
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="FreeTrustDocs" />
  <meta property="og:url" content={`https://freetrustdocs.com${canonical}`} />
  <meta property="og:image" content={`https://freetrustdocs.com/og-image-4.png`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="FreeTrustDocs — Free Trust Document Generator" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`https://freetrustdocs.com/og-image-4.png`} />

  <!-- Fonts: self-hosted woff2 with preload for fastest load -->
  <link rel="preload" href="/fonts/crimson-pro.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/inter.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/jetbrains-mono.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/fonts/fonts.css" />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />

  <!-- Google AdSense - site-wide loader for adsbygoogle ad units -->
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9050447471392236" crossorigin="anonymous"></script>

  <!-- Google Analytics 4 (GA4 property 552750335, stream 15719721688) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-J0FR4EPDTG"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-J0FR4EPDTG');
  </script>

  <!-- UPL: not a law firm -->
  <meta name="robots" content={ogType === 'article' ? 'index, follow' : 'index, follow'} />

  <!-- Entity graph: Organization + WebSite (sitewide). Founder: Kenneth Kohler.
       See GEO skill D2 — verified entity identity + coherent @id graph. -->
  <script type="application/ld+json" set:html={JSON.stringify([
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "@id": "https://freetrustdocs.com/#organization",
      "name": "FreeTrustDocs",
      "url": "https://freetrustdocs.com/",
      "logo": "https://freetrustdocs.com/images/logo/logo-mark-white.svg",
      "description": "Free, private trust document generation. Certificate of Trust, Declaration of Trust, and Land Trust documents generated entirely in your browser — nothing is sent to a server.",
      "email": "support@agentictrust.app",
      "parentOrganization": {
        "@type": "Organization",
        "name": "Agentic Trust",
        "url": "https://agentictrust.app/"
      },
      "founder": {
        "@type": "Person",
        "@id": "https://freetrustdocs.com/about/#founder",
        "name": "Kenneth Kohler",
        "jobTitle": "Founder",
        "image": "https://freetrustdocs.com/images/kenneth-kohler.webp",
        "url": "https://freetrustdocs.com/about/",
        "sameAs": ["https://www.linkedin.com/in/k-jeff-kohler"]
      },
      "knowsAbout": ["Certificate of Trust", "Declaration of Trust", "Land Trust", "Trust Documents", "Trustee Certification", "Uniform Trust Code", "Trust Funding"],
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "support@agentictrust.app",
        "contactType": "customer support",
        "availableLanguage": "English"
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": "https://freetrustdocs.com/#website",
      "url": "https://freetrustdocs.com/",
      "name": "FreeTrustDocs",
      "description": "Free trust document generator — Certificate of Trust, Declaration of Trust, and Land Trust, private by design.",
      "publisher": { "@id": "https://freetrustdocs.com/#organization" },
      "inLanguage": "en-US"
    }
  ])} />

  <style>
    .skip-link {
      position: absolute;
      left: -9999px;
      top: 0;
      z-index: 9999;
      padding: 0.75rem 1rem;
      background: var(--color-accent, #8b6914);
      color: var(--color-cream, #f8f5ef);
      font-weight: 600;
      text-decoration: none;
      border-radius: 0 0 0.25rem 0;
    }
    .skip-link:focus {
      left: 0;
    }
  </style>
</head>
<body>
  <a href="#main" class="skip-link">Skip to content</a>
  <!-- Header -->
  <header class="site-header">
    <div class="container">
      <a href="/" class="site-logo">
        <img src="/images/logo/logo-mark-white.svg" alt="FreeTrustDocs" width="48" height="48" class="logo-mark" />
        <span class="logo-text">Free<span class="logo-doc">Trust</span>Docs</span>
      </a>
      <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false" aria-controls="site-nav">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <nav class="site-nav" id="site-nav">
        <a href="/#showcase-heading">How it works</a>
        <details class="nav-dropdown">
          <summary aria-haspopup="true" aria-expanded="false">Documents <span aria-hidden="true">▾</span></summary>
          <div class="nav-dropdown-menu" role="menu">
            <a href="/certificate-of-trust/" role="menuitem">Certificate of Trust</a>
            <a href="/declaration-of-trust/" role="menuitem">Declaration of Trust</a>
            <a href="/land-trust/" role="menuitem">Land Trust</a>
            <a href="/guide/" role="menuitem">Guides</a>
            <a href="/best-states-for-trusts/" role="menuitem">Best States</a>
            <a href="/about/" role="menuitem">About</a>
            <a href="/legal/disclaimer/" role="menuitem">Disclaimer</a>
          </div>
        </details>
      </nav>
    </div>
  </header>

  <!-- Main content -->
  <main id="main">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <div>
          <div class="site-logo" style="margin-bottom: 0.5rem;">
            <img src="/images/logo/logo-mark-white.svg" alt="FreeTrustDocs" width="44" height="44" class="logo-mark" />
            <span class="logo-text">Free<span style="color: var(--color-accent-light);">Trust</span>Docs</span>
          </div>
          <p style="font-size: 0.9rem; color: rgba(248,245,239,0.7); max-width: 300px;">
            Free, private trust document generation. Nothing leaves your browser.
          </p>
        </div>
        <div class="footer-col">
          <h5>Documents</h5>
          <ul>
            <li><a href="/certificate-of-trust/">Certificate of Trust</a></li>
            <li><a href="/declaration-of-trust/">Declaration of Trust</a></li>
            <li><a href="/land-trust/">Land Trust</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h5>Resources</h5>
          <ul>
            <li><a href="/guide/">Guides</a></li>
            <li><a href="/best-states-for-trusts/">Best States for Trusts</a></li>
            <li><a href="/certificate-of-trust/all-states/">Certificate of Trust — All States</a></li>
            <li><a href="/declaration-of-trust/all-states/">Declaration of Trust — All States</a></li>
            <li><a href="/land-trust/all-states/">Land Trust — State Guide</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h5>Legal</h5>
          <ul>
            <li><a href="/legal/disclaimer/">Disclaimer</a></li>
            <li><a href="/legal/terms/">Terms of Use</a></li>
            <li><a href="/legal/privacy/">Privacy</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-disclaimer">
        <strong>FreeTrustDocs.com is not a law firm and does not provide legal advice.</strong>
        The documents generated by this site are for informational purposes only and do not constitute legal advice.
        You should consult a licensed attorney in your jurisdiction before signing or filing any legal document.
        Use of this site does not create an attorney-client relationship.
      </div>
      <div class="footer-bottom-bar">
        <span>© 2026 Agentic Trust. FreeTrustDocs.com is owned and operated by Agentic Trust.</span>
        <span><a href="/about/">About</a> · <a href="mailto:support@agentictrust.app">Contact</a></span>
      </div>
      {/* Google Preferred Sources — lets visitors add FreeTrustDocs as a preferred source in Google Search */}
      <div class="preferred-source-row">
        <a href="https://www.google.com/preferences/source?q=freetrustdocs.com" target="_blank" rel="noopener noreferrer" class="preferred-source-pill" aria-label="Add FreeTrustDocs as your preferred source in Google Search">
          <svg class="preferred-source-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.539 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.196-1.539-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.783-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path></svg>
          Preferred Source on Google
        </a>
      </div>
    </div>
  </footer>

  <!-- GA4 (add when deployed) -->

  <!-- Hamburger nav toggle (mobile only) -->
  <script is:inline>
    (function () {
      var toggle = document.querySelector('.nav-toggle');
      var nav = document.getElementById('site-nav');
      if (!toggle || !nav) return;
      toggle.addEventListener('click', function () {
        var expanded = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', expanded ? 'false' : 'true');
        nav.classList.toggle('nav-open', !expanded);
      });
    })();
  </script>
</body>
</html>