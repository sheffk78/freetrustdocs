---
import Base from '../../layouts/Base.astro';

const stateName = "Florida";
const title = `Certificate of Trust — ${stateName} | FreeTrustDocs`;
const description = "Certificate of Trust requirements in Florida. Statutes, execution requirements, notary rules, and business trust treatment. Create yours free.";
const statutoryCitation = "Fla. Stat. § 736.1017";
const utcAdopted = true;
const certRequirements = {"governing_section":"Fla. Stat. § 736.1017","contents":["Statement that trust exists and date trust instrument executed","Identity of settlor","Identity and address of currently acting trustee","Powers of the trustee","Whether trust contains powers of direction, identity of current trust directors, and whether directors authorized proposed transaction","Revocability/irrevocability and identity of person holding power to revoke","Authority of co-trustees and whether all or less than all required","Manner of taking title to trust property"],"must_contain":"Statement that trust has not been revoked/modified/amended in manner causing representations to be incorrect","exclusions":"Need not contain dispositive terms of trust. Need not include trust director details if no directors.","statutory_form":"No mandatory statutory form; required contents list governs."};
const executionReqs = {"notary":"Not statutorily required for certification itself. May be signed or otherwise authenticated by any trustee. Third party may require acknowledgment.","witnesses":"Not required.","recording":"May be recorded in real property records where appropriate. Not mandated.","other":"Third parties may rely on certification in good faith; may enforce transaction against trust property as if representations were correct."};
const businessTrust = {"type":"Explicitly EXCLUDED from Florida Trust Code by Fla. Stat. § 736.0102(2). Business trusts providing for certificates to beneficiaries are outside the code.","notes":"Florida recognizes common law business trusts but the Florida Trust Code does not apply to them. Land trusts under § 689.071 also largely excluded."};
const favorableLaws = ["Self-settled spendthrift (Dynasty) trusts permitted under Fla. Stat. § 736.0502","Strong asset protection trust statutes","Homestead protections","UTC-adopted providing uniform rules and interstate consistency"];
const uniqueFactors = ["Adopted UTC with modifications (Chapter 736, Florida Trust Code)","Business trusts explicitly excluded from Trust Code scope","Strong asset protection/Dynasty trust laws","Land trusts under § 689.071 largely excluded from Trust Code","Trust director provisions integrated into certification requirements"];
---

<Base title={title} description={description}>
  <section class="section">
    <div class="container">
      <div class="breadcrumbs">
        <a href="/">Home</a> <span>›</span>
        <a href="/certificate-of-trust/">Certificate of Trust</a> <span>›</span>
        <a href="/certificate-of-trust/all-states/">All States</a> <span>›</span> {stateName}
      </div>

      <h1>Certificate of Trust — {stateName} <span style="font-size: 0.75rem; background: var(--color-primary); color: var(--color-cream); padding: 2px 8px; border-radius: 3px; margin-left: 0.5rem;">UTC Adopted</span></h1>

      <p style="font-size: 1.1rem; color: var(--color-text-muted); margin-bottom: 2rem;">
        State-specific requirements for a Certificate of Trust in {stateName}.
        <a href="/create/certificate-of-trust/">Create yours now →</a>
      </p>

      <div style="display: flex; gap: 1rem; margin-bottom: 2rem;">
        <a href="/create/certificate-of-trust/" class="btn btn-primary">Create Certificate of Trust →</a>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <h2>Statutory Citation</h2>
      <p><code>{statutoryCitation}</code></p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <h2>Certification Requirements</h2>
      <p style="white-space: pre-wrap;">{certRequirements}</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <h2>Execution Requirements</h2>
      <p style="white-space: pre-wrap;">{executionReqs}</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <h2>Business Trust Treatment</h2>
      <p style="white-space: pre-wrap;">{businessTrust}</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <h2>Favorable Trust Laws</h2>
      <p style="white-space: pre-wrap;">{favorableLaws}</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <h2>Unique Factors</h2>
      <p style="white-space: pre-wrap;">{uniqueFactors}</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container-narrow">
      <div class="upl-notice">
        <strong>Not legal advice.</strong>
        This information is for educational purposes based on publicly available statutes.
        Verify current requirements with a licensed Florida attorney before signing or filing.
      </div>
    </div>
  </section>
</Base>