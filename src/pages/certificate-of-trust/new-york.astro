---
import Base from '../../layouts/Base.astro';
import StateAtAGlance from '../../components/StateAtAGlance.astro';

const stateName = "New York";
const stateRecord = {"state":"New York","utc_adopted":false,"statutory_citation":"N.Y. EPTL §§ 7-1.1 et seq. (Article 7, Trusts); no specific cert-of-trust statute","cert_of_trust_requirements":{"governing_section":"No single statutory section governs certification of trust. General trust execution under EPTL § 7-1.17.","contents":["New York does not have a statutory certification-of-trust form comparable to UTC states","Trustees may provide excerpts or certificates of incumbency at common law or by institutional practice","Identity of trustee and powers typically verified by certified copy of trust instrument or excerpt"],"must_contain":"Not statutorily defined for certifications. Trust instruments must comply with EPTL execution requirements.","exclusions":"N/A","statutory_form":"No statutory form exists for a certification of trust under New York law."},"execution_requirements":{"notary":"Trust instruments must be executed with formalities similar to wills or acknowledged before a notary (EPTL § 7-1.17). Certification practice typically includes notarization.","witnesses":"Not required for certification; trust execution may require witnesses depending on type.","recording":"Trust instruments or memoranda may be recorded for real property. Certification is not statutorily governed.","other":"New York relies on common law and institutional custom for certification documents; banks often have internal forms."},"business_trust_treatment":{"type":"Common law business trusts recognized. Additionally, New York Business Corporation Law Article 12 provides for 'Statutory Trusts' with limited liability.","notes":"BCL Article 12 allows creation of statutory business trusts (investment trusts) with certificate holders. Traditional common law Massachusetts trusts also recognized."},"favorable_trust_laws":["Prudent Investor Act (EPTL § 11-2.3) provides clear investment standards","Statutory Trusts under BCL Article 12 offer limited liability business trust vehicle","Perpetuities reform and flexible trust modification rules","Comprehensive EPTL framework with extensive case law"],"unique_factors":["Has NOT adopted UTC; uses Estates, Powers and Trusts Law (EPTL) instead","No statutory certification-of-trust form exists (unlike UTC states)","Statutory Trusts under Business Corporation Law Article 12 provide a statutory business trust vehicle","Common law Massachusetts trusts coexist with statutory business trusts","Trust execution formalities under EPTL § 7-1.17"]};
const title = `Certificate of Trust — ${stateName} | FreeTrustDocs`;
const description = "Certificate of Trust requirements in New York. Statutes, execution requirements, notary rules, and business trust treatment. Create yours free.";
const statutoryCitation = "N.Y. EPTL §§ 7-1.1 et seq. (Article 7, Trusts); no specific cert-of-trust statute";
const utcAdopted = false;
const certRequirements = {"governing_section":"No single statutory section governs certification of trust. General trust execution under EPTL § 7-1.17.","contents":["New York does not have a statutory certification-of-trust form comparable to UTC states","Trustees may provide excerpts or certificates of incumbency at common law or by institutional practice","Identity of trustee and powers typically verified by certified copy of trust instrument or excerpt"],"must_contain":"Not statutorily defined for certifications. Trust instruments must comply with EPTL execution requirements.","exclusions":"N/A","statutory_form":"No statutory form exists for a certification of trust under New York law."};
const executionReqs = {"notary":"Trust instruments must be executed with formalities similar to wills or acknowledged before a notary (EPTL § 7-1.17). Certification practice typically includes notarization.","witnesses":"Not required for certification; trust execution may require witnesses depending on type.","recording":"Trust instruments or memoranda may be recorded for real property. Certification is not statutorily governed.","other":"New York relies on common law and institutional custom for certification documents; banks often have internal forms."};
const businessTrust = {"type":"Common law business trusts recognized. Additionally, New York Business Corporation Law Article 12 provides for 'Statutory Trusts' with limited liability.","notes":"BCL Article 12 allows creation of statutory business trusts (investment trusts) with certificate holders. Traditional common law Massachusetts trusts also recognized."};
const favorableLaws = ["Prudent Investor Act (EPTL § 11-2.3) provides clear investment standards","Statutory Trusts under BCL Article 12 offer limited liability business trust vehicle","Perpetuities reform and flexible trust modification rules","Comprehensive EPTL framework with extensive case law"];
const uniqueFactors = ["Has NOT adopted UTC; uses Estates, Powers and Trusts Law (EPTL) instead","No statutory certification-of-trust form exists (unlike UTC states)","Statutory Trusts under Business Corporation Law Article 12 provide a statutory business trust vehicle","Common law Massachusetts trusts coexist with statutory business trusts","Trust execution formalities under EPTL § 7-1.17"];
---

<Base title={title} description={description}>
  <section class="section">
    <div class="container">
      <div class="breadcrumbs">
        <a href="/">Home</a> <span>›</span>
        <a href="/certificate-of-trust/">Certificate of Trust</a> <span>›</span>
        <a href="/certificate-of-trust/all-states/">All States</a> <span>›</span> {stateName}
      </div>

      <h1>Certificate of Trust — {stateName} <span class="utc-badge utc-badge--non">Non-UTC</span></h1>

      <p class="lede">
        State-specific requirements for a Certificate of Trust in {stateName}.
        <a href="/create/certificate-of-trust/">Create yours now →</a>
      </p>

      <div class="cta-row">
        <a href="/create/certificate-of-trust/" class="btn btn-primary">Create Certificate of Trust →</a>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <StateAtAGlance state={stateRecord} />
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <h2>Statutory Citation</h2>
      <p><code>{statutoryCitation}</code></p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <h2>Certification Requirements</h2>
      <p class="content-prewrap">{certRequirements}</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <h2>Execution Requirements</h2>
      <p class="content-prewrap">{executionReqs}</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <h2>Business Trust Treatment</h2>
      <p class="content-prewrap">{businessTrust}</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <h2>Favorable Trust Laws</h2>
      <p class="content-prewrap">{favorableLaws}</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <h2>Unique Factors</h2>
      <p class="content-prewrap">{uniqueFactors}</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container-narrow">
      <div class="upl-notice">
        <strong>Not legal advice.</strong>
        This information is for educational purposes based on publicly available statutes.
        Verify current requirements with a licensed New York attorney before signing or filing.
      </div>
    </div>
  </section>
</Base>