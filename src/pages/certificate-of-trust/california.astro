---
import Base from '../../layouts/Base.astro';
import StateAtAGlance from '../../components/StateAtAGlance.astro';

const stateName = "California";
const stateRecord = {"state":"California","utc_adopted":false,"statutory_citation":"Cal. Prob. Code § 18100.5","cert_of_trust_requirements":{"governing_section":"Cal. Prob. Code § 18100.5","contents":["Existence of trust and date of execution","Identity of settlor(s)","Identity and powers of currently acting trustee(s)","Revocability/irrevocability and identity of person holding power to revoke","Signature authority of multiple trustees","Trust identification number (SSN or EIN)","Manner of taking title to trust assets","Legal description of real property held in trust"],"must_contain":"Statement that trust has not been revoked/modified in a manner causing representations to be incorrect; statement signed by all currently acting trustees","exclusions":"Need not contain dispositive provisions (distribution terms). May include excerpts designating trustee and succession documents.","statutory_form":"No single statutory form prescribed; requirements list defines contents. Must be an acknowledged declaration."},"execution_requirements":{"notary":"Required. Certification must be in the form of an 'acknowledged declaration' signed by all currently acting trustees.","witnesses":"Not statutorily required for certification of trust.","recording":"May be recorded with county recorder where real property is located. Not required for transfers but permitted.","other":"Anti-bad-faith provision: person demanding full trust docs in addition to cert, without cause, may be liable for damages/attorney fees."},"business_trust_treatment":{"type":"Common law recognized; not a separate statutory entity under California law.","notes":"California treats a trust as a property relationship, not a legal entity. Massachusetts/business trusts exist at common law."},"favorable_trust_laws":["Anti-bad-faith protections for trustees presenting certs (Prob. Code § 18100.5(h))","Strong protections for third parties relying on certifications in good faith","Robust trust administration framework under Probate Code Division 9 (§§ 15000–19530)"],"unique_factors":["Has NOT adopted the UTC; maintains independent comprehensive trust law under Probate Code Division 9","Largest U.S. trust jurisdiction without UTC adoption","Trust is a property relationship, not a legal entity under state law","Certification may be recorded but recording is not mandatory for real property transfers"]};
const title = `Certificate of Trust — ${stateName} | FreeTrustDocs`;
const description = "Certificate of Trust requirements in California. Statutes, execution requirements, notary rules, and business trust treatment. Create yours free.";
const statutoryCitation = "Cal. Prob. Code § 18100.5";
const utcAdopted = false;
const certRequirements = {"governing_section":"Cal. Prob. Code § 18100.5","contents":["Existence of trust and date of execution","Identity of settlor(s)","Identity and powers of currently acting trustee(s)","Revocability/irrevocability and identity of person holding power to revoke","Signature authority of multiple trustees","Trust identification number (SSN or EIN)","Manner of taking title to trust assets","Legal description of real property held in trust"],"must_contain":"Statement that trust has not been revoked/modified in a manner causing representations to be incorrect; statement signed by all currently acting trustees","exclusions":"Need not contain dispositive provisions (distribution terms). May include excerpts designating trustee and succession documents.","statutory_form":"No single statutory form prescribed; requirements list defines contents. Must be an acknowledged declaration."};
const executionReqs = {"notary":"Required. Certification must be in the form of an 'acknowledged declaration' signed by all currently acting trustees.","witnesses":"Not statutorily required for certification of trust.","recording":"May be recorded with county recorder where real property is located. Not required for transfers but permitted.","other":"Anti-bad-faith provision: person demanding full trust docs in addition to cert, without cause, may be liable for damages/attorney fees."};
const businessTrust = {"type":"Common law recognized; not a separate statutory entity under California law.","notes":"California treats a trust as a property relationship, not a legal entity. Massachusetts/business trusts exist at common law."};
const favorableLaws = ["Anti-bad-faith protections for trustees presenting certs (Prob. Code § 18100.5(h))","Strong protections for third parties relying on certifications in good faith","Robust trust administration framework under Probate Code Division 9 (§§ 15000–19530)"];
const uniqueFactors = ["Has NOT adopted the UTC; maintains independent comprehensive trust law under Probate Code Division 9","Largest U.S. trust jurisdiction without UTC adoption","Trust is a property relationship, not a legal entity under state law","Certification may be recorded but recording is not mandatory for real property transfers"];
---

<Base title={title} description={description}>
  <section class="section">
    <div class="container">
      <div class="breadcrumbs">
        <a href="/">Home</a> <span>›</span>
        <a href="/certificate-of-trust/">Certificate of Trust</a> <span>›</span>
        <a href="/certificate-of-trust/all-states/">All States</a> <span>›</span> {stateName}
      </div>

      <h1>Certificate of Trust — {stateName} <span class="utc-badge utc-badge--non">Non-UTC</span></h1>

      <p class="lede">
        State-specific requirements for a Certificate of Trust in {stateName}.
        <a href="/create/certificate-of-trust/">Create yours now →</a>
      </p>

      <div class="cta-row">
        <a href="/create/certificate-of-trust/" class="btn btn-primary">Create Certificate of Trust →</a>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <StateAtAGlance state={stateRecord} />
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <h2>Statutory Citation</h2>
      <p><code>{statutoryCitation}</code></p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <h2>Certification Requirements</h2>
      <p class="content-prewrap">{certRequirements}</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <h2>Execution Requirements</h2>
      <p class="content-prewrap">{executionReqs}</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <h2>Business Trust Treatment</h2>
      <p class="content-prewrap">{businessTrust}</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <h2>Favorable Trust Laws</h2>
      <p class="content-prewrap">{favorableLaws}</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <h2>Unique Factors</h2>
      <p class="content-prewrap">{uniqueFactors}</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container-narrow">
      <div class="upl-notice">
        <strong>Not legal advice.</strong>
        This information is for educational purposes based on publicly available statutes.
        Verify current requirements with a licensed California attorney before signing or filing.
      </div>
    </div>
  </section>
</Base>