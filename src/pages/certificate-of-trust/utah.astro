const stateName = "Utah";
const stateRecord = {"state":"Utah","utc_adopted":true,"statutory_citation":"Utah Code Title 75B, Chapter 2 (Utah Uniform Trust Code); Utah Code § 75B-2-1013 (certification of trust); Utah Code Title 75B, Chapter 1, Part 3 (Asset Protection Trust)","cert_of_trust_requirements":"Under Utah Code § 75B-2-1013, a certification of trust must contain: (a) that the trust exists and the date the trust instrument was executed; (b) the identity of the settlor; (c) the identity and address of the currently acting trustee; (d) the powers of the trustee in the pending transaction; (e) the revocability or irrevocability of the trust and the identity of any person holding a power to revoke; (f) the authority of cotrustees to sign or otherwise authenticate and whether all or less than all are required in order to exercise powers of the trustee; (g) the name in which title to trust property may be taken. A certification of trust may be signed or otherwise authenticated by any trustee. Must state that the trust has not been revoked, modified, or amended in any manner that would cause the representations to be incorrect. Need not contain the dispositive terms of a trust. A recipient may require excerpts designating the trustee and conferring power to act.","execution_requirements":"Under the Utah Uniform Trust Code, the trust instrument must be signed by the settlor. Utah does not require witnesses for trust execution. Notarization is not required for the trust instrument itself, but real property transactions and certificates of trust may require notarization or acknowledgment for recording purposes. Utah recognizes electronic-only trusts.","business_trust_treatment":"Utah requires foreign business trusts to register with the Division of Corporations and Commercial Code under Utah Code Title 16, Chapter 15. Business trusts are treated as business entities requiring a registered agent and are subject to registration requirements similar to corporations and LLCs. Massachusetts-style business trusts must comply with foreign entity registration requirements.","favorable_trust_laws":"Utah has no state estate tax, no inheritance tax, and no gift tax. The state permits 1,000-year dynasty trusts, providing an extremely long perpetuities period. Utah has a Domestic Asset Protection Trust (DAPT) statute under Utah Code Title 75B, Chapter 1, Part 3, permitting self-settled asset protection trusts that meet its statutory requirements. Self-settled spendthrift trusts are permitted with specific statutory requirements.","unique_factors":"Utah has a Domestic Asset Protection Trust statute under Utah Code Title 75B, Chapter 1, Part 3. The state permits 1,000-year dynasty trusts, effectively allowing multi-generational wealth transfer. Utah recognizes electronic-only trusts, which is progressive for digital estate planning."};
const title = `Certificate of Trust — ${stateName} | FreeTrustDocs`;
const description = "Certificate of Trust requirements in Utah. Statutes, execution requirements, notary rules, and business trust treatment. Create yours free.";
const statutoryCitation = "Utah Code Title 75B, Chapter 2 (Utah Uniform Trust Code); Utah Code § 75B-2-1013 (certification of trust); Utah Code Title 75B, Chapter 1, Part 3 (Asset Protection Trust)";
const utcAdopted = true;
const certRequirements = "Under Utah Code § 75B-2-1013, a certification of trust must contain: (a) that the trust exists and the date the trust instrument was executed; (b) the identity of the settlor; (c) the identity and address of the currently acting trustee; (d) the powers of the trustee in the pending transaction; (e) the revocability or irrevocability of the trust and the identity of any person holding a power to revoke; (f) the authority of cotrustees to sign or otherwise authenticate and whether all or less than all are required in order to exercise powers of the trustee; (g) the name in which title to trust property may be taken. A certification of trust may be signed or otherwise authenticated by any trustee. Must state that the trust has not been revoked, modified, or amended in any manner that would cause the representations to be incorrect. Need not contain the dispositive terms of a trust. A recipient may require excerpts designating the trustee and conferring power to act.";
const executionReqs = "Under the Utah Uniform Trust Code, the trust instrument must be signed by the settlor. Utah does not require witnesses for trust execution. Notarization is not required for the trust instrument itself, but real property transactions and certificates of trust may require notarization or acknowledgment for recording purposes. Utah recognizes electronic-only trusts.";
const businessTrust = "Utah requires foreign business trusts to register with the Division of Corporations and Commercial Code under Utah Code Title 16, Chapter 15. Business trusts are treated as business entities requiring a registered agent and are subject to registration requirements similar to corporations and LLCs. Massachusetts-style business trusts must comply with foreign entity registration requirements.";
const favorableLaws = "Utah has no state estate tax, no inheritance tax, and no gift tax. The state permits 1,000-year dynasty trusts, providing an extremely long perpetuities period. Utah has a Domestic Asset Protection Trust (DAPT) statute under Utah Code Title 75B, Chapter 1, Part 3, permitting self-settled asset protection trusts that meet its statutory requirements. Self-settled spendthrift trusts are permitted with specific statutory requirements.";
const uniqueFactors = "Utah has a Domestic Asset Protection Trust statute under Utah Code Title 75B, Chapter 1, Part 3. The state permits 1,000-year dynasty trusts, effectively allowing multi-generational wealth transfer. Utah recognizes electronic-only trusts, which is progressive for digital estate planning.";
const schemaData = {"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://freetrustdocs.com/"},{"@type":"ListItem","position":2,"name":"Certificate of Trust","item":"https://freetrustdocs.com/certificate-of-trust/"},{"@type":"ListItem","position":3,"name":"All States","item":"https://freetrustdocs.com/certificate-of-trust/all-states/"},{"@type":"ListItem","position":4,"name":"Utah","item":"https://freetrustdocs.com/certificate-of-trust/utah/"}]};
---

<Base title={title} description={description}>
  <section class="section">
    <div class="container">
      <div class="breadcrumbs">
        <a href="/">Home</a> <span>›</span>
        <a href="/certificate-of-trust/">Certificate of Trust</a> <span>›</span>
        <a href="/certificate-of-trust/all-states/">All States</a> <span>›</span> {stateName}
      </div>

      <h1>Certificate of Trust — {stateName} <span class="utc-badge utc-badge--adopted">UTC Adopted</span></h1>

      <p class="lede">
        State-specific requirements for a Certificate of Trust in {stateName}.
        <a href="/create/certificate-of-trust/">Create yours now →</a>
      </p>

      <div class="cta-row">
        <a href="/create/certificate-of-trust/" class="btn btn-primary">Create Certificate of Trust →</a>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <StateAtAGlance state={stateRecord} />
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <h2>Statutory Citation</h2>
      <p><code>{statutoryCitation}</code></p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container-narrow">
      <h2>How a Certificate of Trust works in Utah</h2>
  <section class="section-tight">
    <div class="container">
      <h2>Certification Requirements</h2>
      <p class="content-prewrap">{certRequirements}</p>
    </div>
  </section>

      <p>Under Utah Code § 75B-2-1013, a certification of trust is a document that confirms the existence and key terms of a trust without disclosing the trust's dispositive provisions. When a bank or title company in Utah receives a certification of trust, it checks that the document identifies the trust, the settlor, the acting trustee, and the trustee's powers relevant to the pending transaction. The institution relies on the certification because the statute permits a recipient to accept it in lieu of the full trust instrument, so long as the certification states the trust has not been revoked or modified in any manner that would make the representations incorrect. If the certification is missing required information — such as the trustee's address, the revocability status, or the authority of cotrustees — the institution may the recipient may require the trustee to furnish excerpts from the original trust instrument and later amendments that designate the trustee and confer the power to act in the pending transaction.</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container-narrow">
      <h2>Common mistakes that get certificates rejected</h2>
      <p>A certification of trust commonly fails when it omits the trustee's address, which Utah Code § 75B-2-1013 requires as part of the trustee's identity. A second frequent error is stating the trust is revocable when it is irrevocable, or vice versa, because the statute requires the certification to state the revocability status and the identity of any person holding a power to revoke — the recipient may require the trustee to furnish excerpts from the original trust instrument and later amendments that designate the trustee and confer the power to act in the pending transaction. A third common mistake is failing to specify whether all cotrustees or fewer than all may sign to exercise the trustee's powers; without this, a recipient under § 75B-2-1013 may require the full trust instrument. In each case, the institution is permitted to decline the certification and demand the complete trust document before proceeding with the transaction.</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container-narrow">
      <h2>What makes Utah different</h2>
      <p>Utah is a Uniform Trust Code jurisdiction, having recodified the UTC to Title 75B effective 2025, with the certification statute renumbered to § 75B-2-1013 (formerly § 75-7-1013, effective May 7, 2025). Unlike some non-UTC states, Utah's certification requirements are fully aligned with the uniform act, providing consistent institutional recognition. Utah does not require recording of the certification of trust, though real property transactions may require notarization or acknowledgment for recording purposes. Under § 75B-2-1013, a certification may state the trust’s existence, the settlor’s identity, the acting trustee’s identity and address, the trustee’s powers, whether the trust is revocable, and the signature authority of co-trustees — the same core contents the Uniform Trust Code’s § 1013 prescribes, which is why Utah certifications are widely accepted by financial institutions.</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container-narrow">
      <h2>Frequently asked questions</h2>
      <details class="faq-item"><summary>What must a certification of trust contain under Utah law?</summary><p>Under Utah Code § 75B-2-1013, a certification must state: that the trust exists and when executed; the settlor's identity, and the acting trustee's identity and address; the trustee powers relevant to the pending transaction; whether the trust is revocable or irrevocable and who holds a power to revoke; whether all or fewer than all cotrustees may sign; and the name in which title to trust property may be taken. The certification must state the trust has not been revoked or modified in any manner that would make the representations incorrect.</p></details>
      <details class="faq-item"><summary>Who can sign or authenticate a certification of trust?</summary><p>Under the Utah Uniform Trust Code, a certification of trust may be signed or otherwise authenticated by any trustee. The statute does not require all trustees to sign. However, if the certification does not state whether all or fewer than all cotrustees are required to exercise the trustee's powers, a recipient may require the full trust instrument to determine that authority. Utah does not require witnesses or notarization for the certification itself, though recording or real property transactions may require acknowledgment.</p></details>
      <details class="faq-item"><summary>Does a certification of trust reveal the trust's terms or beneficiaries?</summary><p>No. Under Utah Code § 75B-2-1013, a certification of trust need not contain the dispositive terms of the trust. It confirms only the trust's existence, the identities of the settlor and acting trustee, the trustee's powers relevant to the pending transaction, and the trust's revocability status. The statute expressly permits a recipient to accept the certification in lieu of the full trust instrument, which protects the trust's private terms from disclosure to third parties such as banks or title companies.</p></details>
      <details class="faq-item"><summary>Can a bank or title company require the full trust instrument?</summary><p>Yes. Under Utah Code § 75B-2-1013, a recipient may require excerpts designating the trustee and conferring the power to act. If the certification of trust is missing required information — for example, the identity of the settlor, the trustee's address, or the authority of cotrustees — the institution may the recipient may require the trustee to furnish excerpts from the original trust instrument and later amendments that designate the trustee and confer the power to act in the pending transaction. The statute also requires that the certification state the trust has not been revoked or modified; if that representation is unclear, the recipient has grounds to request the complete instrument.</p></details>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <h2>Execution Requirements</h2>
      <p class="content-prewrap">{executionReqs}</p>
    </div>
  </section>
  <section class="section-tight">
    <div class="container">
      <h2>Business Trust Treatment</h2>
      <p class="content-prewrap">{businessTrust}</p>
    </div>
  </section>
  <section class="section-tight">
    <div class="container">
      <h2>Favorable Trust Laws</h2>
      <p class="content-prewrap">{favorableLaws}</p>
    </div>
  </section>
  <section class="section-tight">
    <div class="container">
      <h2>Unique Factors</h2>
      <p class="content-prewrap">{uniqueFactors}</p>
    </div>
  </section>
  <section class="section-tight">
    <div class="container-narrow">
      <div class="upl-notice">
        <strong>Not legal advice.</strong>
        This information is for educational purposes based on publicly available statutes.
        Verify current requirements with a licensed Utah attorney before signing or filing.
      </div>
    </div>
</section>
