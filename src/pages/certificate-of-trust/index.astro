---
import Base from '../../layouts/Base.astro';
import Callout from '../../components/Callout.astro';

const title = 'Certificate of Trust — Free Generator & State Guide';
const description = 'Create a Certificate of Trust online for free. UTC §1013-style. 5-minute wizard, client-side PDF generation. State-specific guides for all 50 states.';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is a Certificate of Trust used for?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A Certificate of Trust is used to prove that a trust exists and that the trustee is authorized to act on its behalf, without revealing the full private trust agreement. Banks, title companies, and financial institutions typically require it when you open accounts, transfer real property, or conduct business on behalf of a trust."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need a Certificate of Trust to open a bank account?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Most banks require a Certificate of Trust (or the full trust agreement) to open a trust bank account. The certificate allows you to prove the trust exists and that you are the authorized trustee without disclosing your beneficiaries or the dispositive terms of your trust."
      }
    },
    {
      "@type": "Question",
      "name": "Does a Certificate of Trust replace the full trust agreement?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. A Certificate of Trust does not replace the full trust agreement. It is a summary document that certifies only the essential facts — trust existence, trustee authority, revocability, and tax ID — while keeping beneficiary identities and distribution details private. The full trust agreement is still the governing document."
      }
    },
    {
      "@type": "Question",
      "name": "Is a Certificate of Trust valid in all states?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A Certificate of Trust is recognized under the Uniform Trust Code §1013, which has been adopted in most U.S. states. Some states (CA, TX, NY, DE, NV, SD, ID, LA, RI, IN) have their own trust statutes with slightly different requirements. You should verify that your certificate meets your state's specific statutory requirements."
      }
    },
    {
      "@type": "Question",
      "name": "How much does a Certificate of Trust cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Using FreeTrustDocs, you can generate a Certificate of Trust for free. There is no signup required and the PDF is generated entirely in your browser. If you hire an attorney to prepare one, the cost typically ranges from $100 to $500 depending on complexity and your location."
      }
    }
  ]
};
---

<Base title={title} description={description}>
  <section class="section">
    <div class="container">
      <div class="breadcrumbs">
        <a href="/">Home</a> <span>›</span> Certificate of Trust
      </div>

      <h1>Certificate of Trust</h1>

      <p style="font-size: 1.15rem; color: var(--color-text-muted); margin-bottom: 2rem;">
        A Certificate of Trust proves a trust exists and authorizes the trustee to act —
        without disclosing the full private trust agreement. Required by banks, title companies,
        and financial institutions under the Uniform Trust Code §1013.
      </p>

      <div style="display: flex; gap: 1rem; margin-bottom: 2rem;">
        <a href="/create/certificate-of-trust/" class="btn btn-primary btn-lg">Create Certificate of Trust →</a>
        <a href="#what-is" class="btn btn-outline btn-lg">Learn More</a>
      </div>

      <Callout variant="tip" label="Quick facts">
        <p>
          5-minute wizard · 14-section PDF document · UTC §1013-style · No signup required ·
          Generated entirely in your browser · Free
        </p>
      </Callout>
    </div>
  </section>

  <section class="section-tight" id="what-is">
    <div class="container">
      <h2>What is a Certificate of Trust?</h2>
      <p>
        A Certificate of Trust (also called a Certification of Trust or Memorandum of Trust) is a summary document
        that allows a trustee to prove the existence of a trust and their authority to act on its behalf —
        without revealing the full terms of the trust agreement. It is recognized under
        <strong>Uniform Trust Code §1013</strong>, which has been adopted in most U.S. states.
        Some states (CA, TX, NY, DE, NV, SD, ID, LA, RI, IN) have their own trust statutes instead.
      </p>
      <p>
        When you open a bank account, transfer real property, or conduct business on behalf of a trust,
        the institution will typically ask for proof that the trust exists and that you are authorized to act.
        The Certificate of Trust provides exactly this — it certifies the essential facts without
        disclosing the private dispositive provisions (who gets what).
      </p>

      <figure class="ftd-diagram" style="margin: 2.25rem 0;">
        <svg viewBox="0 0 720 450" xmlns="http://www.w3.org/2000/svg" style="width: 100%; height: auto; display: block;" font-family="'Crimson Pro', serif" role="img" aria-label="A Certificate of Trust summarizes the private trust agreement and shows only the facts institutions need, keeping beneficiary and asset details private.">
          <rect width="720" height="450" fill="#f8f5ef"/>
          <!-- Top flow: Trust Agreement -> Certificate of Trust -> Institution -->
          <rect x="20" y="44" width="200" height="72" fill="none" stroke="#1a3c34" stroke-width="1.5" rx="2"/>
          <text x="120" y="70" text-anchor="middle" font-size="15" font-weight="600" fill="#1a3c34">Trust Agreement</text>
          <text x="120" y="90" text-anchor="middle" font-size="11" font-family="Inter, sans-serif" font-style="italic" fill="#8b6914">your full private document</text>
          <line x1="220" y1="80" x2="288" y2="80" stroke="#8b6914" stroke-width="1.5"/>
          <polygon points="290,80 282,76 282,84" fill="#8b6914"/>
          <text x="255" y="66" text-anchor="middle" font-size="11" font-family="Inter, sans-serif" fill="#2a2a2a">summarizes</text>
          <rect x="292" y="44" width="180" height="72" fill="none" stroke="#1a3c34" stroke-width="1.5" rx="2"/>
          <text x="382" y="70" text-anchor="middle" font-size="15" font-weight="600" fill="#1a3c34">Certificate of Trust</text>
          <text x="382" y="90" text-anchor="middle" font-size="11" font-family="Inter, sans-serif" font-style="italic" fill="#8b6914">UTC §1013 — facts only</text>
          <line x1="472" y1="80" x2="528" y2="80" stroke="#8b6914" stroke-width="1.5"/>
          <polygon points="530,80 522,76 522,84" fill="#8b6914"/>
          <text x="501" y="66" text-anchor="middle" font-size="11" font-family="Inter, sans-serif" fill="#2a2a2a">presented to</text>
          <rect x="532" y="44" width="168" height="72" fill="none" stroke="#1a3c34" stroke-width="1.5" rx="2"/>
          <text x="616" y="70" text-anchor="middle" font-size="15" font-weight="600" fill="#1a3c34">Bank · Title Co.</text>
          <text x="616" y="90" text-anchor="middle" font-size="11" font-family="Inter, sans-serif" font-style="italic" fill="#8b6914">verifies trustee authority</text>
          <!-- Divider -->
          <line x1="20" y1="140" x2="700" y2="140" stroke="#d4cfc4" stroke-width="1"/>
          <!-- Left panel: what it certifies -->
          <rect x="20" y="158" width="330" height="248" fill="none" stroke="#1a3c34" stroke-width="1.5" rx="2"/>
          <text x="36" y="184" font-size="14" font-weight="600" fill="#1a3c34">What the certificate shows</text>
          <line x1="36" y1="196" x2="334" y2="196" stroke="#1a3c34" stroke-width="1"/>
          <g font-family="Inter, sans-serif" font-size="12" fill="#2a2a2a">
            <rect x="38" y="212" width="8" height="8" fill="none" stroke="#1a3c34" stroke-width="1.5"/>
            <text x="54" y="220">Trust exists &amp; execution date</text>
            <rect x="38" y="238" width="8" height="8" fill="none" stroke="#1a3c34" stroke-width="1.5"/>
            <text x="54" y="246">Settlor identity</text>
            <rect x="38" y="264" width="8" height="8" fill="none" stroke="#1a3c34" stroke-width="1.5"/>
            <text x="54" y="272">Trustee identity &amp; powers</text>
            <rect x="38" y="290" width="8" height="8" fill="none" stroke="#1a3c34" stroke-width="1.5"/>
            <text x="54" y="298">Revocability (who may revoke)</text>
            <rect x="38" y="316" width="8" height="8" fill="none" stroke="#1a3c34" stroke-width="1.5"/>
            <text x="54" y="324">Co-trustee signing rules</text>
            <rect x="38" y="342" width="8" height="8" fill="none" stroke="#1a3c34" stroke-width="1.5"/>
            <text x="54" y="350">Trust tax ID (SSN / EIN)</text>
            <rect x="38" y="368" width="8" height="8" fill="none" stroke="#1a3c34" stroke-width="1.5"/>
            <text x="54" y="376">Manner of taking title</text>
          </g>
          <text x="36" y="398" font-size="11" font-family="Inter, sans-serif" font-style="italic" fill="#8b6914">Shown to institutions to certify authority</text>
          <!-- Right panel: what stays private -->
          <rect x="370" y="158" width="330" height="248" fill="none" stroke="#8b6914" stroke-width="1.5" rx="2"/>
          <text x="386" y="184" font-size="14" font-weight="600" fill="#8b6914">What stays private</text>
          <line x1="386" y1="196" x2="684" y2="196" stroke="#8b6914" stroke-width="1"/>
          <g font-family="Inter, sans-serif" font-size="12" fill="#2a2a2a">
            <rect x="388" y="212" width="8" height="8" fill="none" stroke="#8b6914" stroke-width="1.5"/>
            <text x="404" y="220">Beneficiaries' identities</text>
            <rect x="388" y="238" width="8" height="8" fill="none" stroke="#8b6914" stroke-width="1.5"/>
            <text x="404" y="246">Who gets what (dispositive terms)</text>
            <rect x="388" y="264" width="8" height="8" fill="none" stroke="#8b6914" stroke-width="1.5"/>
            <text x="404" y="272">Distribution amounts &amp; timing</text>
          </g>
          <text x="386" y="398" font-size="11" font-family="Inter, sans-serif" font-style="italic" fill="#8b6914">Never disclosed — protects your estate plan</text>
        </svg>
        <figcaption style="font-family: Inter, sans-serif; font-size: 0.85rem; color: var(--color-text-muted); margin-top: 0.6rem; text-align: center;">
          A Certificate of Trust certifies authority without revealing who the beneficiaries are or what they receive.
        </figcaption>
      </figure>

      <h3>What it contains</h3>
      <ul>
        <li><strong>Trust existence and date</strong> — that the trust exists and when the trust instrument was executed</li>
        <li><strong>Settlor identity</strong> — who created the trust</li>
        <li><strong>Trustee identity and address</strong> — who is currently acting as trustee</li>
        <li><strong>Trustee powers</strong> — a synopsis of the trustee's relevant powers</li>
        <li><strong>Revocability status</strong> — whether the trust is revocable or irrevocable, and who holds the power to revoke</li>
        <li><strong>Co-trustee authority</strong> — if there are multiple trustees, whether all must sign or fewer may act</li>
        <li><strong>Trust tax ID</strong> — the trust's taxpayer identification number (SSN or EIN)</li>
        <li><strong>Manner of taking title</strong> — how trust property should be titled</li>
        <li><strong>Statement of non-revocation</strong> — that the trust has not been revoked or modified in a way that invalidates the certification</li>
      </ul>

      <h3>What it does NOT contain</h3>
      <p>
        The Certificate of Trust does <strong>not</strong> include the dispositive provisions of the trust —
        meaning it does not reveal who the beneficiaries are, what they receive, or how distributions are made.
        This is the key privacy benefit: you can prove authority to act without exposing your estate plan.
      </p>

      <h3>Institutional acceptance</h3>
      <p>
        Under UTC §1013(h), a person who demands the full trust instrument in addition to a Certificate of Trust
        <em>without good faith</em> may be liable for damages and attorney's fees. Most banks, title companies,
        and financial institutions are familiar with the Certificate of Trust and will accept it in lieu of the
        full trust agreement. Some institutions may still request the full instrument — this is permitted if they
        have a good faith reason to do so.
      </p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <h2>State Requirements</h2>
      <p>
        While the Uniform Trust Code provides a model, each state has its own specific requirements for
        what a Certificate of Trust must contain, whether notarization is required, and whether it can be recorded.
        We have research guides for all 50 states:
      </p>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.5rem;">
        {[
          'Alabama', 'Alaska', 'Arizona', 'Arkansas', 'California', 'Colorado', 'Connecticut', 'Delaware',
          'Florida', 'Georgia', 'Hawaii', 'Idaho', 'Illinois', 'Indiana', 'Iowa', 'Kansas', 'Kentucky',
          'Louisiana', 'Maine', 'Maryland', 'Massachusetts', 'Michigan', 'Minnesota', 'Mississippi', 'Missouri',
          'Montana', 'Nebraska', 'Nevada', 'New Hampshire', 'New Jersey', 'New Mexico', 'New York',
          'North Carolina', 'North Dakota', 'Ohio', 'Oklahoma', 'Oregon', 'Pennsylvania', 'Rhode Island',
          'South Carolina', 'South Dakota', 'Tennessee', 'Texas', 'Utah', 'Vermont', 'Virginia',
          'Washington', 'West Virginia', 'Wisconsin', 'Wyoming',
        ].map((state) => {
          const slug = state.toLowerCase().replace(/\s+/g, '-');
          return (
            <a href={`/certificate-of-trust/${slug}/`} style="font-size: 0.9rem;">
              {state}
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section-tight" id="faq">
    <div class="container-narrow">
      <h2>Frequently Asked Questions</h2>

      <details>
        <summary>What is a Certificate of Trust used for?</summary>
        <p>A Certificate of Trust is used to prove that a trust exists and that the trustee is authorized to act on its behalf, without revealing the full private trust agreement. Banks, title companies, and financial institutions typically require it when you open accounts, transfer real property, or conduct business on behalf of a trust.</p>
      </details>

      <details>
        <summary>Do I need a Certificate of Trust to open a bank account?</summary>
        <p>Most banks require a Certificate of Trust (or the full trust agreement) to open a trust bank account. The certificate allows you to prove the trust exists and that you are the authorized trustee without disclosing your beneficiaries or the dispositive terms of your trust.</p>
      </details>

      <details>
        <summary>Does a Certificate of Trust replace the full trust agreement?</summary>
        <p>No. A Certificate of Trust does not replace the full trust agreement. It is a summary document that certifies only the essential facts — trust existence, trustee authority, revocability, and tax ID — while keeping beneficiary identities and distribution details private. The full trust agreement is still the governing document.</p>
      </details>

      <details>
        <summary>Is a Certificate of Trust valid in all states?</summary>
        <p>A Certificate of Trust is recognized under the Uniform Trust Code §1013, which has been adopted in most U.S. states. Some states (CA, TX, NY, DE, NV, SD, ID, LA, RI, IN) have their own trust statutes with slightly different requirements. You should verify that your certificate meets your state's specific statutory requirements.</p>
      </details>

      <details>
        <summary>How much does a Certificate of Trust cost?</summary>
        <p>Using FreeTrustDocs, you can generate a Certificate of Trust for free. There is no signup required and the PDF is generated entirely in your browser. If you hire an attorney to prepare one, the cost typically ranges from $100 to $500 depending on complexity and your location.</p>
      </details>
    </div>
  </section>

  <section class="section-tight">
    <div class="container-narrow">
      <div class="upl-notice">
        <strong>Not a law firm.</strong>
        FreeTrustDocs.com does not provide legal advice. The Certificate of Trust generated by this tool
        is a factual certification of information you provide. You should verify that the generated document
        meets your state's specific statutory requirements and consult a licensed attorney if you have questions.
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Base>