---
import Base from '../../layouts/Base.astro';
import StateAtAGlance from '../../components/StateAtAGlance.astro';

const stateName = "South Carolina";
const stateRecord = {"state":"South Carolina","utc_adopted":true,"statutory_citation":"South Carolina Code Title 62, Article 7 (South Carolina Trust Code), adopted 2005; SC Code § 62-7-1013 (certification of trust); SC Code § 33-53-10 (business trusts)","cert_of_trust_requirements":"Under SC Code § 62-7-1013, a certification of trust must contain: (1) that the trust exists and the date the trust instrument was executed; (2) the identity of the settlor; (3) the identity and address of the currently acting trustee; (4) the powers of the trustee (may reference SCTC powers); (5) the revocability or irrevocability of the trust and the identity of any person holding a power to revoke; (6) the authority of cotrustees to sign or otherwise authenticate and whether all or less than all are required; (7) the manner of taking title to trust property. Must state that the trust has not been revoked, modified, or amended in any manner that would cause the representations to be incorrect. Need not contain the dispositive terms of a trust. A statutory form is provided in § 62-7-1013(k). For real property transactions, the certificate must be executed and acknowledged in a manner permitting recordation. A recipient may require excerpts designating the trustee and conferring power to act.","execution_requirements":"The South Carolina Trust Code does not require witnesses for trust execution. The trust instrument must be signed by the settlor. For real property transactions involving a certificate of trust, the certificate must be executed and acknowledged before a notary public or other official authorized to administer oaths, in a manner permitting recordation in the Office of the Register of Deeds or Clerk of Court. Trust instruments affecting real property may be recorded, but general trust instruments are not required to be recorded.","business_trust_treatment":"South Carolina recognizes business trusts under SC Code § 33-53-10, which requires every business trust created at common law in the State or doing business in the State under an express trust instrument to record the instrument creating the trust with the Register of Deeds. Business trusts are treated as common law trusts with recording requirements and are subject to the South Carolina Trust Code provisions where applicable.","favorable_trust_laws":"South Carolina does not have a Domestic Asset Protection Trust (DAPT) statute. The rule against perpetuities applies, limiting trust duration to lives in being plus 21 years, except for cemetery care trusts (SC Code § 62-7-406). South Carolina imposes state income tax on trust income but has no separate state estate tax beyond the federal system. Spendthrift provisions are recognized under the Trust Code. The state provides a statutory certificate of trust form.","unique_factors":"South Carolina is notable for providing a detailed statutory form for certificates of trust in § 62-7-1013(k), which is uncommon among UTC states. The state does not have a DAPT statute, making it less favorable for asset protection compared to leading trust jurisdictions. The Trust Code was adopted in 2005 and is closely modeled on the Uniform Trust Code."};
const title = `Certificate of Trust — ${stateName} | FreeTrustDocs`;
const description = "Certificate of Trust requirements in South Carolina. Statutes, execution requirements, notary rules, and business trust treatment. Create yours free.";
const statutoryCitation = "South Carolina Code Title 62, Article 7 (South Carolina Trust Code), adopted 2005; SC Code § 62-7-1013 (certification of trust); SC Code § 33-53-10 (business trusts)";
const utcAdopted = true;
const certRequirements = "Under SC Code § 62-7-1013, a certification of trust must contain: (1) that the trust exists and the date the trust instrument was executed; (2) the identity of the settlor; (3) the identity and address of the currently acting trustee; (4) the powers of the trustee (may reference SCTC powers); (5) the revocability or irrevocability of the trust and the identity of any person holding a power to revoke; (6) the authority of cotrustees to sign or otherwise authenticate and whether all or less than all are required; (7) the manner of taking title to trust property. Must state that the trust has not been revoked, modified, or amended in any manner that would cause the representations to be incorrect. Need not contain the dispositive terms of a trust. A statutory form is provided in § 62-7-1013(k). For real property transactions, the certificate must be executed and acknowledged in a manner permitting recordation. A recipient may require excerpts designating the trustee and conferring power to act.";
const executionReqs = "The South Carolina Trust Code does not require witnesses for trust execution. The trust instrument must be signed by the settlor. For real property transactions involving a certificate of trust, the certificate must be executed and acknowledged before a notary public or other official authorized to administer oaths, in a manner permitting recordation in the Office of the Register of Deeds or Clerk of Court. Trust instruments affecting real property may be recorded, but general trust instruments are not required to be recorded.";
const businessTrust = "South Carolina recognizes business trusts under SC Code § 33-53-10, which requires every business trust created at common law in the State or doing business in the State under an express trust instrument to record the instrument creating the trust with the Register of Deeds. Business trusts are treated as common law trusts with recording requirements and are subject to the South Carolina Trust Code provisions where applicable.";
const favorableLaws = "South Carolina does not have a Domestic Asset Protection Trust (DAPT) statute. The rule against perpetuities applies, limiting trust duration to lives in being plus 21 years, except for cemetery care trusts (SC Code § 62-7-406). South Carolina imposes state income tax on trust income but has no separate state estate tax beyond the federal system. Spendthrift provisions are recognized under the Trust Code. The state provides a statutory certificate of trust form.";
const uniqueFactors = "South Carolina is notable for providing a detailed statutory form for certificates of trust in § 62-7-1013(k), which is uncommon among UTC states. The state does not have a DAPT statute, making it less favorable for asset protection compared to leading trust jurisdictions. The Trust Code was adopted in 2005 and is closely modeled on the Uniform Trust Code.";
const schemaData = {"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://freetrustdocs.com/"},{"@type":"ListItem","position":2,"name":"Certificate of Trust","item":"https://freetrustdocs.com/certificate-of-trust/"},{"@type":"ListItem","position":3,"name":"All States","item":"https://freetrustdocs.com/certificate-of-trust/all-states/"},{"@type":"ListItem","position":4,"name":"South Carolina","item":"https://freetrustdocs.com/certificate-of-trust/south-carolina/"}]};
---

<Base title={title} description={description}>
  <section class="section">
    <div class="container">
      <div class="breadcrumbs">
        <a href="/">Home</a> <span>›</span>
        <a href="/certificate-of-trust/">Certificate of Trust</a> <span>›</span>
        <a href="/certificate-of-trust/all-states/">All States</a> <span>›</span> {stateName}
      </div>

      <h1>Certificate of Trust — {stateName} <span class="utc-badge utc-badge--adopted">UTC Adopted</span></h1>

      <p class="lede">
        State-specific requirements for a Certificate of Trust in {stateName}.
        <a href="/create/certificate-of-trust/">Create yours now →</a>
      </p>

      <div class="cta-row">
        <a href="/create/certificate-of-trust/" class="btn btn-primary">Create Certificate of Trust →</a>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <StateAtAGlance state={stateRecord} />
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <h2>Statutory Citation</h2>
      <p><code>{statutoryCitation}</code></p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <h2>Certification Requirements</h2>
      <p class="content-prewrap">{certRequirements}</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <h2>Execution Requirements</h2>
      <p class="content-prewrap">{executionReqs}</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <h2>Business Trust Treatment</h2>
      <p class="content-prewrap">{businessTrust}</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <h2>Favorable Trust Laws</h2>
      <p class="content-prewrap">{favorableLaws}</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <h2>Unique Factors</h2>
      <p class="content-prewrap">{uniqueFactors}</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container-narrow">
      <div class="upl-notice">
        <strong>Not legal advice.</strong>
        This information is for educational purposes based on publicly available statutes.
        Verify current requirements with a licensed South Carolina attorney before signing or filing.
      </div>
    </div>
</section>
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
</Base>