---
import Base from '../layouts/Base.astro';
import TierBadge from '../components/TierBadge.astro';

const title = 'Best States for Trusts — Asset Protection, Privacy & Tax Comparison';
const description = 'Compare the best states for trusts: Delaware, Nevada, South Dakota, Wyoming, Alaska, Tennessee. Asset protection, dynasty trusts, tax treatment, and perpetuities rules.';

const bestStates = [
  {
    name: 'South Dakota',
    tier: 1,
    incomeTax: 'None',
    estateTax: 'None',
    rapPeriod: 'Abolished (perpetual)',
    dapt: 'Yes (2-year seasoning)',
    notary: 'Not required for cert',
    utc: 'Yes',
    highlights: [
      'Perpetual dynasty trusts — no rule against perpetuities',
      'Self-settled asset protection trusts with short 2-year seasoning',
      'No state income tax, no estate tax, no inheritance tax',
      'Strong privacy — trust filings not public record',
      'Dedicated trust courts and experienced trust industry',
    ],
    bestFor: 'Asset protection, dynasty trusts, privacy',
  },
  {
    name: 'Nevada',
    tier: 1,
    incomeTax: 'None',
    estateTax: 'None',
    rapPeriod: '365 years',
    dapt: 'Yes (2-year seasoning)',
    notary: 'Not required for cert',
    utc: 'No (own statutes)',
    highlights: [
      '365-year dynasty trust period — among the longest',
      'Self-settled spendthrift trusts with 2-year seasoning',
      'No state income tax, no estate tax',
      'Comprehensive statutory business trust framework (NRS Ch. 88A)',
      'Strong charging order protection for DAPTs',
    ],
    bestFor: 'Asset protection, business trusts, dynasty trusts',
  },
  {
    name: 'Delaware',
    tier: 1,
    incomeTax: 'None on out-of-state trusts',
    estateTax: 'None',
    rapPeriod: 'Abolished (perpetual)',
    dapt: 'Yes (4-year seasoning)',
    notary: 'Not required for cert',
    utc: 'No (own statutes)',
    highlights: [
      'Perpetual dynasty trusts — no rule against perpetuities',
      'Self-settled asset protection trusts (4-year seasoning)',
      'Delaware Statutory Trust (DST) — widely used business trust vehicle',
      'No state income tax for non-resident trusts',
      'Court of Chancery — specialized business/trust court',
    ],
    bestFor: 'Business trusts (DST), institutional trust administration',
  },
  {
    name: 'Wyoming',
    tier: 1,
    incomeTax: 'None',
    estateTax: 'None',
    rapPeriod: '1,000 years',
    dapt: 'Yes (4-year seasoning)',
    notary: 'Not required for cert',
    utc: 'No (own statutes)',
    highlights: [
      '1,000-year dynasty trust period',
      'Self-settled asset protection trusts',
      'No state income tax, no estate tax',
      'Low fees and minimal regulation',
      'Strong privacy protections',
    ],
    bestFor: 'Asset protection, privacy, cost-conscious trust administration',
  },
  {
    name: 'Alaska',
    tier: 1,
    incomeTax: 'None',
    estateTax: 'None',
    rapPeriod: '1,000 years',
    dapt: 'Yes (4-year seasoning)',
    notary: 'Not required for cert',
    utc: 'No (own statutes)',
    highlights: [
      'Pioneered self-settled asset protection trusts (1997)',
      '1,000-year dynasty trust period',
      'No state income tax, no estate tax',
      'Alaska Trust Act — comprehensive DAPT framework',
      'Requires Alaska trustee and partial administration in Alaska',
    ],
    bestFor: 'Asset protection, dynasty trusts',
  },
  {
    name: 'Tennessee',
    tier: 2,
    incomeTax: 'None (wages)',
    estateTax: 'None',
    rapPeriod: 'Abolished (perpetual)',
    dapt: 'Yes (2-year seasoning)',
    notary: 'Not required for cert',
    utc: 'Yes',
    highlights: [
      'Perpetual dynasty trusts — abolished RAP',
      'Self-settled spendthrift trusts with short 2-year seasoning',
      'No state income tax on wages, no estate tax',
      'Explicitly codifies Massachusetts trust law',
      'Modern UTC adoption with directed trust provisions',
    ],
    bestFor: 'Asset protection, dynasty trusts, business trusts',
  },
  {
    name: 'Florida',
    tier: 2,
    incomeTax: 'None',
    estateTax: 'None',
    rapPeriod: '360 years',
    dapt: 'Yes',
    notary: 'Not required for cert',
    utc: 'Yes',
    highlights: [
      'Self-settled spendthrift (Dynasty) trusts permitted',
      '360-year perpetuity period',
      'No state income tax, no estate tax',
      'Strong homestead protections',
      'UTC-adopted with trust director provisions',
    ],
    bestFor: 'Dynasty trusts, homestead protection, warm-climate situs',
  },
  {
    name: 'Ohio',
    tier: 2,
    incomeTax: 'Yes (flat ~3.5%)',
    estateTax: 'None (repealed)',
    rapPeriod: 'Abolished (opt-out)',
    dapt: 'No',
    notary: 'Not required for cert',
    utc: 'Yes',
    highlights: [
      'Dynasty trust opt-out (ORC § 2131.09(B)) — requires affirmative statement + unlimited trustee power',
      'No state estate tax (repealed)',
      'Comprehensive business trust statute (ORC Ch. 1746)',
      'Memorandum of trust concept for real property (ORC § 5301.255)',
      'Business trusts are separate unincorporated legal entities',
    ],
    bestFor: 'Business trusts, dynasty trusts',
  },
];
---

<Base title={title} description={description}>
  <section class="section">
    <div class="container">
      <div class="breadcrumbs"><a href="/">Home</a> <span>›</span> Best States for Trusts</div>

      <h1>Best States for Trusts</h1>
      <p style="font-size: 1.15rem; color: var(--color-text-muted); margin-bottom: 2rem;">
        Which states offer the most favorable trust laws for asset protection, privacy, dynasty trusts, and tax?
        Here's a comparison of the top trust jurisdictions in the United States.
      </p>

      <div class="upl-notice">
        <strong>Not legal advice.</strong> This comparison is for informational purposes only.
        Trust situs (the state whose laws govern the trust) involves complex legal and tax considerations.
        Consult a licensed attorney before choosing a trust jurisdiction.
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <h2>Comparison Table</h2>

      <div class="tier-callout" role="note">
        <strong>How to read the tiers.</strong>
        Every state below is a favorable trust jurisdiction. The seal beside each state is a
        <em>tier marker</em>, not a pass/fail grade: <strong>Tier I</strong> marks the leading
        all-around jurisdictions (deep green) — states that combine perpetual or very long dynasty
        trusts, self-settled asset protection, no state tax, and strong privacy. <strong>Tier II</strong>
        marks strong alternatives (bronze) that are excellent for specific goals but carry a caveat,
        such as a state income tax (Ohio), a notable trade-off, or a narrower fit. Pick the state that
        matches what the trust needs to accomplish, not the highest tier alone. Details follow in the
        table and the breakdown below.
      </div>

      <div class="tier-legend" aria-label="Tier legend">
        <span class="tier-legend-item"><TierBadge tier={1} /> <strong>Tier I</strong> — Leading jurisdiction</span>
        <span class="tier-legend-item"><TierBadge tier={2} /> <strong>Tier II</strong> — Strong alternative</span>
      </div>

      <div style="overflow-x: auto;">
        <table class="table">
          <thead>
            <tr>
              <th>State</th>
              <th>State Income Tax</th>
              <th>Estate/Inheritance Tax</th>
              <th>Rule Against Perpetuities</th>
              <th>Self-Settled Asset Protection</th>
              <th>UTC Adopted</th>
            </tr>
          </thead>
          <tbody>
            {bestStates.map((s) => (
              <tr>
                <td><TierBadge tier={s.tier} name={s.name} /><strong>{s.name}</strong></td>
                <td>{s.incomeTax}</td>
                <td>{s.estateTax}</td>
                <td>{s.rapPeriod}</td>
                <td>{s.dapt}</td>
                <td>{s.utc}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <h2>Detailed Breakdown</h2>
      {bestStates.map((s) => (
        <div class="state-card">
          <div class="state-card-head">
            <span class="state-outline" aria-hidden="true">
              {s.name === 'South Dakota' && (
                <svg viewBox="0 0 100 70" xmlns="http://www.w3.org/2000/svg"><path d="M5 8 L95 8 L95 30 L82 32 L82 62 L65 62 L60 55 L40 55 L35 62 L18 62 L18 32 L5 30 Z" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
              )}
              {s.name === 'Nevada' && (
                <svg viewBox="0 0 100 70" xmlns="http://www.w3.org/2000/svg"><path d="M15 5 L72 5 L88 28 L85 55 L72 62 L55 60 L45 55 L25 50 L12 28 Z" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
              )}
              {s.name === 'Delaware' && (
                <svg viewBox="0 0 100 70" xmlns="http://www.w3.org/2000/svg"><path d="M75 5 L92 8 L92 25 L88 35 L82 48 L72 55 L60 58 L55 50 L62 40 L68 25 L72 15 Z" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
              )}
              {s.name === 'Wyoming' && (
                <svg viewBox="0 0 100 70" xmlns="http://www.w3.org/2000/svg"><rect x="10" y="10" width="80" height="50" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
              )}
              {s.name === 'Alaska' && (
                <svg viewBox="0 0 100 70" xmlns="http://www.w3.org/2000/svg"><path d="M8 45 L22 25 L35 20 L50 15 L65 12 L78 18 L85 30 L72 38 L60 42 L48 48 L35 52 L22 55 L12 52 Z" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
              )}
              {s.name === 'Tennessee' && (
                <svg viewBox="0 0 100 70" xmlns="http://www.w3.org/2000/svg"><path d="M8 15 L88 12 L90 28 L85 45 L78 55 L65 58 L52 55 L42 50 L30 48 L18 42 L10 30 Z" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
              )}
              {s.name === 'Florida' && (
                <svg viewBox="0 0 100 70" xmlns="http://www.w3.org/2000/svg"><path d="M20 5 L75 5 L78 22 L72 35 L65 45 L60 55 L55 65 L50 62 L45 55 L40 45 L35 35 L30 22 L25 12 Z" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
              )}
              {s.name === 'Ohio' && (
                <svg viewBox="0 0 100 70" xmlns="http://www.w3.org/2000/svg"><path d="M15 18 L82 15 L88 28 L85 42 L75 52 L60 55 L45 52 L30 48 L18 40 L12 28 Z" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
              )}
            </span>
            <div class="state-card-title">
              <h3><TierBadge tier={s.tier} name={s.name} /> {s.name}</h3>
              <p class="state-best-for"><strong>Best for:</strong> {s.bestFor}</p>
            </div>
          </div>
          <div class="state-card-body">
            <div class="state-card-highlights">
              <ul>
                {s.highlights.map((h) => <li>{h}</li>)}
              </ul>
            </div>
            <aside class="state-card-facts">
              <div class="fact-row"><span class="fact-label">Income Tax</span><span class="fact-value">{s.incomeTax}</span></div>
              <div class="fact-row"><span class="fact-label">Estate Tax</span><span class="fact-value">{s.estateTax}</span></div>
              <div class="fact-row"><span class="fact-label">RAP Period</span><span class="fact-value">{s.rapPeriod}</span></div>
              <div class="fact-row"><span class="fact-label">DAPT</span><span class="fact-value">{s.dapt}</span></div>
              <div class="fact-row"><span class="fact-label">UTC</span><span class="fact-value">{s.utc}</span></div>
              <div class="fact-row"><span class="fact-label">Notary</span><span class="fact-value">{s.notary}</span></div>
            </aside>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <h2>Key Factors to Consider</h2>

      <h3>Rule Against Perpetuities (RAP)</h3>
      <p>
        The RAP limits how long a trust can last. States that have abolished or extended RAP allow "dynasty trusts"
        that can last for centuries or indefinitely, preserving wealth across multiple generations without
        triggering transfer taxes at each generation.
      </p>

      <figure class="ftd-diagram" style="margin: 2rem 0;">
        <svg viewBox="0 0 720 400" xmlns="http://www.w3.org/2000/svg" style="width: 100%; height: auto; display: block;" font-family="'Crimson Pro', serif" role="img" aria-label="Horizontal chart comparing how long a dynasty trust can last in leading states: South Dakota, Delaware and Tennessee permit perpetual trusts; Wyoming and Alaska about 1,000 years; Nevada 365 years; Florida 360 years; Ohio allows perpetual trusts by election.">
          <rect width="720" height="400" fill="#f8f5ef"/>
          <text x="170" y="40" font-size="13" font-family="Inter, sans-serif" font-weight="600" fill="#1a3c34">≈ maximum trust duration (years)</text>
          <!-- grid baseline -->
          <line x1="170" y1="370" x2="590" y2="370" stroke="#d4cfc4" stroke-width="1"/>
          <g font-family="Inter, sans-serif" font-size="11" fill="#2a2a2a">
            <!-- South Dakota: perpetual -->
            <text x="160" y="78" text-anchor="end" font-family="'Crimson Pro', serif" font-size="13" font-weight="600" fill="#1a3c34">South Dakota</text>
            <line x1="170" y1="70" x2="590" y2="70" stroke="#8b6914" stroke-width="1.5"/>
            <text x="598" y="74" fill="#8b6914">∞ in perpetuity</text>
            <!-- Delaware -->
            <text x="160" y="116" text-anchor="end" font-family="'Crimson Pro', serif" font-size="13" font-weight="600" fill="#1a3c34">Delaware</text>
            <line x1="170" y1="108" x2="590" y2="108" stroke="#8b6914" stroke-width="1.5"/>
            <text x="598" y="112" fill="#8b6914">∞ in perpetuity</text>
            <!-- Tennessee -->
            <text x="160" y="154" text-anchor="end" font-family="'Crimson Pro', serif" font-size="13" font-weight="600" fill="#1a3c34">Tennessee</text>
            <line x1="170" y1="146" x2="590" y2="146" stroke="#8b6914" stroke-width="1.5"/>
            <text x="598" y="150" fill="#8b6914">∞ in perpetuity</text>
            <!-- Wyoming 1000 -->
            <text x="160" y="192" text-anchor="end" font-family="'Crimson Pro', serif" font-size="13" font-weight="600" fill="#1a3c34">Wyoming</text>
            <line x1="170" y1="184" x2="550" y2="184" stroke="#1a3c34" stroke-width="1.5"/>
            <text x="558" y="188">1,000 yrs</text>
            <!-- Alaska 1000 -->
            <text x="160" y="230" text-anchor="end" font-family="'Crimson Pro', serif" font-size="13" font-weight="600" fill="#1a3c34">Alaska</text>
            <line x1="170" y1="222" x2="550" y2="222" stroke="#1a3c34" stroke-width="1.5"/>
            <text x="558" y="226">1,000 yrs</text>
            <!-- Nevada 365 -->
            <text x="160" y="268" text-anchor="end" font-family="'Crimson Pro', serif" font-size="13" font-weight="600" fill="#1a3c34">Nevada</text>
            <line x1="170" y1="260" x2="309" y2="260" stroke="#1a3c34" stroke-width="1.5"/>
            <text x="317" y="264">365 yrs</text>
            <!-- Florida 360 -->
            <text x="160" y="306" text-anchor="end" font-family="'Crimson Pro', serif" font-size="13" font-weight="600" fill="#1a3c34">Florida</text>
            <line x1="170" y1="298" x2="307" y2="298" stroke="#1a3c34" stroke-width="1.5"/>
            <text x="315" y="302">360 yrs</text>
            <!-- Ohio opt-out -->
            <text x="160" y="344" text-anchor="end" font-family="'Crimson Pro', serif" font-size="13" font-weight="600" fill="#1a3c34">Ohio</text>
            <line x1="170" y1="336" x2="590" y2="336" stroke="#8b6914" stroke-width="1.5"/>
            <text x="598" y="340" fill="#8b6914">∞ via election</text>
          </g>
          <text x="170" y="388" font-size="11" font-family="Inter, sans-serif" font-style="italic" fill="#8b6914">Bronze = perpetual (no statutory time limit). Longer trust duration lets wealth pass to later generations.</text>
        </svg>
        <figcaption style="font-family: Inter, sans-serif; font-size: 0.85rem; color: var(--color-text-muted); margin-top: 0.6rem; text-align: center;">
          Dynasty trusts last longest where the rule against perpetuities is abolished or greatly extended.
        </figcaption>
      </figure>

      <h3>Self-Settled Asset Protection Trusts (DAPTs)</h3>
      <p>
        A DAPT allows you to create an irrevocable trust for your own benefit with creditor protection.
        "Seasoning period" is how long assets must be in the trust before they're protected from creditors.
        Shorter seasoning (2 years) is more favorable.
      </p>

      <h3>Tax Treatment</h3>
      <p>
        States with no income tax, no estate tax, and no inheritance tax are most favorable for trust administration.
        Some states (like Delaware) exempt out-of-state trusts from state income tax entirely.
      </p>

      <h3>Privacy</h3>
      <p>
        Some states require trust filings to be public record (e.g., Ohio business trusts). Others keep trust
        information private. For maximum privacy, look at South Dakota, Nevada, and Wyoming.
      </p>

      <h3>UTC Adoption</h3>
      <p>
        States that adopted the Uniform Trust Code have standardized, predictable trust laws that institutions
        understand. Non-UTC states (Nevada, Delaware) may have more specialized or flexible frameworks.
      </p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container-narrow">
      <div class="upl-notice">
        <strong>Not legal advice.</strong> This information is for educational purposes only.
        Choosing a trust situs involves federal tax law, state tax law, and conflict-of-law principles.
        Always consult a licensed estate planning attorney before establishing a trust in any jurisdiction.
      </div>
    </div>
  </section>
</Base>

<style>
  .tier-callout {
    background: var(--color-cream-dark);
    border-left: 3px solid var(--color-primary);
    padding: var(--space-md) var(--space-lg);
    margin: var(--space-md) 0 var(--space-lg);
    font-size: 0.92rem;
    color: var(--color-text-muted);
  }
  .tier-callout strong {
    color: var(--color-primary-dark);
  }
  .tier-legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    margin-bottom: var(--space-md);
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
  .tier-legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
  }
  .tier-legend-item strong {
    color: var(--color-primary-dark);
  }
  /* ---- State cards ---- */
  .state-card {
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-accent);
    border-radius: var(--border-radius);
    padding: var(--space-lg);
    margin-bottom: 2rem;
    background: var(--color-white);
  }
  .state-card-head {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
  }
  .state-outline {
    flex-shrink: 0;
    width: 56px;
    height: 42px;
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .state-outline svg { width: 100%; height: 100%; }
  .state-card-title h3 { margin: 0 0 0.25rem; }
  .state-best-for { font-size: 0.9rem; color: var(--color-text-muted); margin: 0; }
  .state-card-body {
    display: grid;
    grid-template-columns: 1fr 240px;
    gap: var(--space-lg);
  }
  .state-card-highlights ul { margin: 0; padding-left: 1.1rem; line-height: 1.7; }
  .state-card-facts {
    border-left: 1px solid var(--color-border);
    padding-left: var(--space-md);
  }
  .fact-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .fact-row:last-child { border-bottom: none; }
  .fact-label {
    font: 600 0.68rem var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }
  .fact-value {
    font-size: 0.85rem;
    color: var(--color-primary-dark);
    text-align: right;
    max-width: 140px;
  }
  @media (max-width: 768px) {
    .state-card-body { grid-template-columns: 1fr; }
    .state-card-facts { border-left: none; border-top: 1px solid var(--color-border); padding-left: 0; padding-top: var(--space-sm); }
    .state-outline { width: 44px; height: 33px; }
  }
</style>