---
import Base from '../../layouts/Base.astro';

const title = 'Disclaimer — FreeTrustDocs';
const description = 'FreeTrustDocs.com is not a law firm and does not provide legal advice. Read our full disclaimer.';
---

<Base title={title} description={description}>
  <section class="section">
    <div class="container-narrow">
      <div class="breadcrumbs"><a href="/">Home</a> <span>›</span> Legal <span>›</span> Disclaimer</div>
      <h1>Disclaimer</h1>

      <div class="upl-notice">
        <strong>FreeTrustDocs.com is not a law firm and does not provide legal advice.</strong>
      </div>

      <h2>What We Provide</h2>
      <p>
        FreeTrustDocs.com provides a free online tool that generates trust-related legal documents
        (Certificate of Trust, Declaration of Trust, Land Trust) from information you provide.
        The tool asks you questions and assembles a document from your answers using standardized templates.
        This is a document assembly service, not legal advice.
      </p>

      <h2>What We Do Not Provide</h2>
      <ul>
        <li>We do not provide legal advice.</li>
        <li>We do not recommend specific trust structures for your situation.</li>
        <li>We do not advise on tax consequences of trust formation or operation.</li>
        <li>We do not suggest or guarantee asset protection outcomes.</li>
        <li>We do not review your completed document for legal sufficiency.</li>
        <li>We do not represent you or create an attorney-client relationship.</li>
      </ul>

      <h2>Your Responsibilities</h2>
      <ul>
        <li>You are responsible for verifying that the generated document meets your state's specific statutory requirements.</li>
        <li>You should consult a licensed attorney in your jurisdiction before signing or filing any legal document.</li>
        <li>You are responsible for the accuracy of the information you provide to the tool.</li>
        <li>You are responsible for proper execution (notarization, witnesses, recording) of the completed document.</li>
      </ul>

      <h2>No Attorney-Client Relationship</h2>
      <p>
        Use of FreeTrustDocs.com does not create an attorney-client relationship between you and FreeTrustDocs.com,
        its operators, or any affiliated parties. Communications through this site are not confidential or privileged.
      </p>

      <h2>Limitation of Liability</h2>
      <p>
        FreeTrustDocs.com is provided "as is" without warranty of any kind. We make no representation regarding
        the suitability, accuracy, or completeness of any document generated by this tool. You use the
        generated documents at your own risk.
      </p>

      <h2>Not Legal Advice</h2>
      <p>
        The information and documents provided by FreeTrustDocs.com constitute legal information, not legal advice.
        Legal information is general information about the law. Legal advice is a recommendation about what you
        should do in your specific situation. Only a licensed attorney can provide legal advice.
      </p>

      <h2>UPL Compliance Statement</h2>
      <p>
        FreeTrustDocs.com operates as a document preparation service that asks users questions and assembles
        documents from user inputs. The tool does not recommend specific trust structures, does not customize
        provisions based on user goals, and does not provide individualized guidance. Users choose from a menu
        of options without any "recommended for you" logic.
      </p>
    </div>
  </section>
</Base>