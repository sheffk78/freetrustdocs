---
import Base from '../layouts/Base.astro';

const title = 'About FreeTrustDocs — Who We Are';
const description = 'FreeTrustDocs is built and operated by Kenneth Kohler and Agentic Trust — free, private trust document generation as part of a complete trust toolkit.';
---

<Base title={title} description={description}>
  <section class="section">
    <div class="container-narrow">
      <div class="breadcrumbs"><a href="/">Home</a> <span>›</span> About</div>

      <div class="about-hero">
        <h1>About FreeTrustDocs</h1>

        <div class="about-photo">
          <img src="/images/kenneth-kohler.webp" alt="Kenneth Kohler, founder of FreeTrustDocs" width="168" height="168" loading="lazy" />
        </div>

        <p style="font-size: 1.15rem; color: var(--color-text-muted);">
          Free, private trust document generation — built by someone who manages trusts himself.
        </p>

        <h2>Why FreeTrustDocs exists</h2>
        <p>
          FreeTrustDocs was created by <strong>Kenneth Kohler</strong>, founder of
          <a href="https://trustoffice.app">TrustOffice</a>. Kenneth has helped hundreds of people
          set up and manage their private trusts, and he governs his own. One lesson from that work:
          forming a trust is the easy part — and the paperwork that proves the trust exists
          shouldn't cost hundreds of dollars or require a law office.
        </p>
        <p>
          A Certificate of Trust, a Declaration of Trust, or a Land Trust Agreement are documents
          banks, title companies, and county recorders ask for every day. FreeTrustDocs generates
          them free, in your browser, in minutes — with real, state-specific research behind each
          template.
        </p>

        <h2>Private by design</h2>
        <p>
          Nothing you type into a FreeTrustDocs wizard is ever sent to a server. There are no
          accounts, no databases, and no document uploads. The PDF is assembled locally on your
          device. Your trust documents are nobody's business but yours — including ours.
        </p>

        <h2>Not a law firm</h2>
        <p>
          FreeTrustDocs is a document assembly tool, not legal advice. We don't recommend specific
          trust structures or advise on tax consequences. For complex matters, consult a licensed
          attorney in your state. <a href="/legal/disclaimer/">Read the full disclaimer →</a>
        </p>

        <h2>Part of a complete trust toolkit</h2>
        <p>
          FreeTrustDocs is operated by <strong>Agentic Trust</strong> and is the first step in a
          family of trust tools built by Kenneth Kohler:
        </p>
        <ul>
          <li><strong><a href="https://trustminutes.app">TrustMinutes</a></strong> — keep audit-ready meeting minutes and records as you govern the trust.</li>
          <li><strong><a href="https://trustoffice.app">TrustOffice</a></strong> — AI-powered trust administration for trustees who take fiduciary duty seriously.</li>
        </ul>

        <h2 id="founder">About the founder</h2>
        <p>
          Kenneth Kohler has spent his career in marketing, video production, software, and AI
          automation — and since 2021, managing and helping others manage private trusts. He built
          FreeTrustDocs and the tools around it because trustees deserve better than Word documents
          and legal pads.
        </p>
        <p>
          <a href="https://www.linkedin.com/in/k-jeff-kohler">Connect with Kenneth on LinkedIn →</a>
        </p>
      </div>
    </div>
  </section>
</Base>