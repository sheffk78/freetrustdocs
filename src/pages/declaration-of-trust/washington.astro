---

<Base title={title} description={description}>
  <section class="section">
    <div class="container">
      <div class="breadcrumbs">
        <a href="/">Home</a> <span>›</span>
        <a href="/declaration-of-trust/">Declaration of Trust</a> <span>›</span>
        <a href="/declaration-of-trust/all-states/">All States</a> <span>›</span> {stateName}
      </div>

      <h1>Declaration of Trust — {stateName} <span class="utc-badge utc-badge--adopted">UTC Adopted</span></h1>

      <p class="lede">
        State-specific requirements for creating a Declaration of Trust in {stateName}.
        <a href="/create/declaration-of-trust/">Create yours now →</a>
      </p>

