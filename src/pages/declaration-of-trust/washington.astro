    <div class="container">
      <StateAtAGlance state={stateRecord} />
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <h2>Governing Statute</h2>
      <p><code>Revised Code of Washington (RCW) Title 11, Chapter 11.98 (Trusts) and Chapter 11.103 (Uniform Trust Code provisions adopted 2011); RCW 11.98.075 (certification of trust); RCW Chapter 23.90 (Massachusetts trusts)</code></p>
    </div>
  </section>

