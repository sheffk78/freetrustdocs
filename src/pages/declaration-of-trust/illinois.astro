---
import Base from '../../layouts/Base.astro';
import StateAtAGlance from '../../components/StateAtAGlance.astro';

const stateName = "Illinois";
const stateRecord = {"state":"Illinois","utc_adopted":true,"statutory_citation":"760 ILCS 3/1013","cert_of_trust_requirements":{"governing_section":"760 ILCS 3/1013","contents":["Statement that trust exists and date trust instrument executed","Identity of settlor","Identity and address of currently acting trustee","Powers of the trustee","Revocability/irrevocability; amendability/unamendability; identity of person holding power to revoke","Authority of co-trustees and whether all or less than all required","Trust's taxpayer identification number","Manner of taking title to trust property"],"must_contain":"Statement that trust has not been revoked/modified/amended in manner causing representations to be incorrect","exclusions":"Need not contain dispositive terms of trust.","statutory_form":"Optional statutory form provided in 760 ILCS 3/1013(j). Use of other forms is not barred."},"execution_requirements":{"notary":"Not statutorily required for certification itself. Must be signed or otherwise authenticated by one or more trustees. Third party may require acknowledgment (notary).","witnesses":"Not required.","recording":"May be recorded in real property records. Not mandated.","other":"Third parties may rely on cert without liability if no actual knowledge of error. Demand for full trust instrument in addition to cert may expose demanding party to damages if not in good faith."},"business_trust_treatment":{"type":"Common law business trusts recognized. Statutory business trusts governed by Illinois Business Trust Act (760 ILCS 35/).","notes":"Illinois has both common law business trusts and a statutory framework under 760 ILCS 35/ (Trusts and Dissolutions of Marriage Act not directly applicable; business trust provisions exist)."},"favorable_trust_laws":["Illinois Trust Code adopted (760 ILCS 3/), providing UTC-based uniformity","Optional statutory certification form reduces guesswork","Illinois Land Trust statute (765 ILCS 405/) offers unique privacy vehicle for real estate","Charitable Trust Act provides clear registration framework"],"unique_factors":["Adopted UTC (760 ILCS 3/)","Provides optional statutory certification form in the statute itself","Illinois Land Trust is a unique statutory trust form used heavily in real estate (765 ILCS 405/)","Business trusts recognized under both common law and statutory law (760 ILCS 35/)","Oral trusts permitted but must be proven by clear and convincing evidence"]};
const title = `Declaration of Trust — ${stateName} | FreeTrustDocs`;
const description = "Declaration of Trust requirements in Illinois. Governing statutes, execution requirements, business trust treatment. Create yours free.";
const statutoryCitation = "760 ILCS 3/1013";
const utcAdopted = true;
const certRequirements = {"governing_section":"760 ILCS 3/1013","contents":["Statement that trust exists and date trust instrument executed","Identity of settlor","Identity and address of currently acting trustee","Powers of the trustee","Revocability/irrevocability; amendability/unamendability; identity of person holding power to revoke","Authority of co-trustees and whether all or less than all required","Trust's taxpayer identification number","Manner of taking title to trust property"],"must_contain":"Statement that trust has not been revoked/modified/amended in manner causing representations to be incorrect","exclusions":"Need not contain dispositive terms of trust.","statutory_form":"Optional statutory form provided in 760 ILCS 3/1013(j). Use of other forms is not barred."};
const executionReqs = {"notary":"Not statutorily required for certification itself. Must be signed or otherwise authenticated by one or more trustees. Third party may require acknowledgment (notary).","witnesses":"Not required.","recording":"May be recorded in real property records. Not mandated.","other":"Third parties may rely on cert without liability if no actual knowledge of error. Demand for full trust instrument in addition to cert may expose demanding party to damages if not in good faith."};
const businessTrust = {"type":"Common law business trusts recognized. Statutory business trusts governed by Illinois Business Trust Act (760 ILCS 35/).","notes":"Illinois has both common law business trusts and a statutory framework under 760 ILCS 35/ (Trusts and Dissolutions of Marriage Act not directly applicable; business trust provisions exist)."};
const favorableLaws = ["Illinois Trust Code adopted (760 ILCS 3/), providing UTC-based uniformity","Optional statutory certification form reduces guesswork","Illinois Land Trust statute (765 ILCS 405/) offers unique privacy vehicle for real estate","Charitable Trust Act provides clear registration framework"];
const uniqueFactors = ["Adopted UTC (760 ILCS 3/)","Provides optional statutory certification form in the statute itself","Illinois Land Trust is a unique statutory trust form used heavily in real estate (765 ILCS 405/)","Business trusts recognized under both common law and statutory law (760 ILCS 35/)","Oral trusts permitted but must be proven by clear and convincing evidence"];
const schemaData = {"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://freetrustdocs.com/"},{"@type":"ListItem","position":2,"name":"Declaration of Trust","item":"https://freetrustdocs.com/declaration-of-trust/"},{"@type":"ListItem","position":3,"name":"All States","item":"https://freetrustdocs.com/declaration-of-trust/all-states/"},{"@type":"ListItem","position":4,"name":"Illinois","item":"https://freetrustdocs.com/declaration-of-trust/illinois/"}]};
---

<Base title={title} description={description}>
  <section class="section">
    <div class="container">
      <div class="breadcrumbs">
        <a href="/">Home</a> <span>›</span>
        <a href="/declaration-of-trust/">Declaration of Trust</a> <span>›</span>
        <a href="/declaration-of-trust/all-states/">All States</a> <span>›</span> {stateName}
      </div>

      <h1>Declaration of Trust — {stateName} <span class="utc-badge utc-badge--adopted">UTC Adopted</span></h1>

      <p class="lede">
        State-specific requirements for creating a Declaration of Trust in {stateName}.
        <a href="/create/declaration-of-trust/">Create yours now →</a>
      </p>

      <div class="cta-row">
        <a href="/create/declaration-of-trust/" class="btn btn-primary">Create Declaration of Trust →</a>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <StateAtAGlance state={stateRecord} />
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <h2>Governing Statute</h2>
      <p><code>760 ILCS 3/1013</code></p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <h2>Execution Requirements</h2>
      <p class="content-prewrap">{executionReqs}</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <h2>Business Trust Treatment</h2>
      <p class="content-prewrap">{businessTrust}</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <h2>Favorable Trust Laws</h2>
      <p class="content-prewrap">{favorableLaws}</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <h2>Unique Factors</h2>
      <p class="content-prewrap">{uniqueFactors}</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <h2>Certification of Trust in Illinois</h2>
      <p class="content-prewrap">{certRequirements}</p>
      <p style="margin-top: 1rem; font-size: 0.9rem; color: var(--color-text-muted);">
        Already have a trust? You may also need a <a href="/certificate-of-trust/illinois/">Certificate of Trust for Illinois</a> to prove its existence to banks and institutions.
      </p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container-narrow">
      <div class="upl-notice">
        <strong>Not legal advice.</strong>
        This information is for educational purposes based on publicly available statutes.
        Verify current requirements with a licensed Illinois attorney before signing or filing.
      </div>
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
</Base>