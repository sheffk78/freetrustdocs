---
import Base from '../../layouts/Base.astro';
import Callout from '../../components/Callout.astro';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is a Declaration of Trust?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A Declaration of Trust is a legal document that creates a trust and states its terms — the trust name, the settlor who creates it, the trustee who administers it, the beneficiaries, and the property that makes up the trust. It is the foundational agreement that establishes the trust relationship."
      }
    },
    {
      "@type": "Question",
      "name": "Is a Declaration of Trust the same as a trust agreement?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, a Declaration of Trust is also commonly called a Trust Agreement. Both terms refer to the document that establishes a trust, identifies the parties, and sets out the rules governing how the trust operates. The terms are used interchangeably in most contexts."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need a lawyer to create a Declaration of Trust?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You are not legally required to use a lawyer to create a Declaration of Trust. Tools like FreeTrustDocs let you generate one yourself for free. However, trust law varies by state and the consequences of errors can be significant. You should consult a licensed attorney if you have questions about your specific situation."
      }
    },
    {
      "@type": "Question",
      "name": "What's the difference between a Declaration of Trust and a Certificate of Trust?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A Declaration of Trust is the full trust agreement that creates the trust and includes all of its terms. A Certificate of Trust is a short summary document that certifies the trust exists and the trustee is authorized to act, without revealing the full private terms. Institutions often accept a Certificate of Trust in lieu of the full agreement."
      }
    },
    {
      "@type": "Question",
      "name": "Can I modify a Declaration of Trust after signing?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "If the trust is revocable, the settlor can typically modify or revoke the Declaration of Trust at any time. If the trust is irrevocable, modifications are much more limited and may require beneficiary consent or court approval. The ability to modify depends on the terms of the trust and your state's laws."
      }
    }
  ]
};
---

<Base title="Declaration of Trust — Free Online Generator" description="Create a Declaration of Trust / Private Contract Trust online for free. Business trust structure. Answer a few questions, get a completed PDF. No signup.">
  <section class="section">
    <div class="container">
      <div class="breadcrumbs"><a href="/">Home</a> <span>›</span> Declaration of Trust</div>
      <h1>Declaration of Trust</h1>
      <p style="font-size: 1.15rem; color: var(--color-text-muted); margin-bottom: 2rem;">
        Create a Private Contract Trust — a business trust agreement where a trustee holds legal title
        to assets for beneficiaries. Massachusetts Trust heritage.
      </p>

      <div style="margin-bottom: 2rem;">
        <a href="/create/declaration-of-trust/" class="btn btn-primary btn-lg">Create Declaration of Trust →</a>
      </div>

      <Callout variant="info" label="How it works">
        <p>
          Answer a few questions about your trust — name, settlor, trustee, beneficiaries, governing
          state — and the tool assembles a complete Declaration of Trust from your inputs. The PDF is
          generated entirely in your browser. No data is sent to any server.
        </p>
      </Callout>

      <div style="margin-top: 2rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem;">
        <div>
          <h3>What it is</h3>
          <p style="color: var(--color-text-muted); font-size: 0.95rem;">
            A Declaration of Trust (also called a Trust Agreement) creates a trust and states its terms —
            the trust name, the settlor who creates it, the trustee who administers it, the beneficiaries,
            and the property that makes up the trust.
          </p>
        </div>
        <div>
          <h3>Business trust structure</h3>
          <p style="color: var(--color-text-muted); font-size: 0.95rem;">
            In a business or Private Contract Trust, a trustee holds legal title to business assets for the
            benefit of beneficiaries. Different states treat these structures differently — consult an
            attorney about the rules that apply to your situation.
          </p>
        </div>
        <div>
          <h3>Your browser, your data</h3>
          <p style="color: var(--color-text-muted); font-size: 0.95rem;">
            Your answers never leave your device. The PDF is generated client-side, so nothing is stored
            on any server.
          </p>
        </div>
      </div>

      <div class="upl-notice" style="margin-top: 2rem;">
        <strong>Not a law firm.</strong> FreeTrustDocs.com is not a law firm and does not provide legal advice.
        This document is a template assembled from information you provide. You should consult a licensed
        attorney in your jurisdiction before signing or filing any legal document. Use of this tool does not
        create an attorney-client relationship.
      </div>
    </div>
  </section>

  <section class="section-tight" id="faq">
    <div class="container-narrow">
      <h2>Frequently Asked Questions</h2>
      <p class="faq-hint">Select a question to view its answer.</p>

      <details class="faq-item">
        <summary><span class="faq-q">Q</span><span class="faq-text">What is a Declaration of Trust?</span><span class="faq-icon" aria-hidden="true"></span></summary>
        <div class="faq-a"><span class="faq-a-badge" aria-hidden="true">A</span><p>A Declaration of Trust is a legal document that creates a trust and states its terms — the trust name, the settlor who creates it, the trustee who administers it, the beneficiaries, and the property that makes up the trust. It is the foundational agreement that establishes the trust relationship.</p></div>
      </details>

      <details class="faq-item">
        <summary><span class="faq-q">Q</span><span class="faq-text">Is a Declaration of Trust the same as a trust agreement?</span><span class="faq-icon" aria-hidden="true"></span></summary>
        <div class="faq-a"><span class="faq-a-badge" aria-hidden="true">A</span><p>Yes, a Declaration of Trust is also commonly called a Trust Agreement. Both terms refer to the document that establishes a trust, identifies the parties, and sets out the rules governing how the trust operates. The terms are used interchangeably in most contexts.</p></div>
      </details>

      <details class="faq-item">
        <summary><span class="faq-q">Q</span><span class="faq-text">Do I need a lawyer to create a Declaration of Trust?</span><span class="faq-icon" aria-hidden="true"></span></summary>
        <div class="faq-a"><span class="faq-a-badge" aria-hidden="true">A</span><p>You are not legally required to use a lawyer to create a Declaration of Trust. Tools like FreeTrustDocs let you generate one yourself for free. However, trust law varies by state and the consequences of errors can be significant. You should consult a licensed attorney if you have questions about your specific situation.</p></div>
      </details>

      <details class="faq-item">
        <summary><span class="faq-q">Q</span><span class="faq-text">What's the difference between a Declaration of Trust and a Certificate of Trust?</span><span class="faq-icon" aria-hidden="true"></span></summary>
        <div class="faq-a"><span class="faq-a-badge" aria-hidden="true">A</span><p>A Declaration of Trust is the full trust agreement that creates the trust and includes all of its terms. A Certificate of Trust is a short summary document that certifies the trust exists and the trustee is authorized to act, without revealing the full private terms. Institutions often accept a Certificate of Trust in lieu of the full agreement.</p></div>
      </details>

      <details class="faq-item">
        <summary><span class="faq-q">Q</span><span class="faq-text">Can I modify a Declaration of Trust after signing?</span><span class="faq-icon" aria-hidden="true"></span></summary>
        <div class="faq-a"><span class="faq-a-badge" aria-hidden="true">A</span><p>If the trust is revocable, the settlor can typically modify or revoke the Declaration of Trust at any time. If the trust is irrevocable, modifications are much more limited and may require beneficiary consent or court approval. The ability to modify depends on the terms of the trust and your state's laws.</p></div>
      </details>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Base>
