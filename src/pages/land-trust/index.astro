---
import Base from '../../layouts/Base.astro';
import Callout from '../../components/Callout.astro';
---

<Base title="Land Trust — Free Generator (Coming Soon)" description="Create a Land Trust agreement online for free. Privacy and probate avoidance for real property. Coming soon.">
  <section class="section">
    <div class="container-narrow" style="text-align: center;">
      <div class="breadcrumbs"><a href="/">Home</a> <span>›</span> Land Trust</div>
      <h1>Land Trust</h1>
      <p style="font-size: 1.15rem; color: var(--color-text-muted); margin-bottom: 2rem;">
        Hold real property in a trust for privacy and probate avoidance. The trustee's name appears
        on public records; the beneficiary's stays private. Recognized mainly in Illinois and Florida.
      </p>
      <Callout variant="warning" label="Coming soon">
        <p>
          The Land Trust wizard is under development. In the meantime, you can create a{' '}
          <a href="/certificate-of-trust/">Certificate of Trust</a> — it's available now and takes
          about 5 minutes.
        </p>
      </Callout>
      <div style="margin-top: 2rem;">
        <a href="/certificate-of-trust/" class="btn btn-primary">Create Certificate of Trust →</a>
      </div>
    </div>
  </section>
</Base>