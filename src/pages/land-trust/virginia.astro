const schemaData = {"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://freetrustdocs.com/"},{"@type":"ListItem","position":2,"name":"Land Trust","item":"https://freetrustdocs.com/land-trust/"},{"@type":"ListItem","position":3,"name":"Virginia","item":"https://freetrustdocs.com/land-trust/virginia/"}]};
---
<Base title={title} description={description}>
  <section class="section">
    <div class="container">
      <div class="breadcrumbs">
        <a href="/">Home</a> <span>›</span>
        <a href="/land-trust/">Land Trust</a> <span>›</span> {stateName}
      </div>
