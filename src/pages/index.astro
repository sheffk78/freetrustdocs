---
import Base from '../layouts/Base.astro';

const documents = [
  {
    title: 'Certificate of Trust',
    href: '/certificate-of-trust/',
    create: '/create/certificate-of-trust/',
    description: 'Prove a trust exists and certify the trustee\'s authority — without disclosing the full trust agreement. Required by banks, title companies, and financial institutions.',
    meta: '5-minute wizard · 14-section PDF · UTC §1013 compliant',
    status: 'available',
  },
  {
    title: 'Declaration of Trust',
    href: '/declaration-of-trust/',
    create: '/create/declaration-of-trust/',
    description: 'Create a Private Contract Trust — a business trust agreement where a trustee holds legal title to assets for beneficiaries. Massachusetts Trust heritage.',
    meta: '8-question wizard · 15-section PDF · Business trust structure',
    status: 'available',
  },
  {
    title: 'Land Trust',
    href: '/land-trust/',
    create: '/create/land-trust/',
    description: 'Hold real property in a trust for privacy and probate avoidance. The trustee\'s name appears on public records; the beneficiary\'s stays private.',
    meta: '7-question wizard · 15-section PDF · IL, FL, and recognizing states',
    status: 'coming-soon',
  },
];

const processSteps = [
  {
    title: 'Choose',
    desc: 'Pick a Certificate of Trust, Declaration of Trust, or Land Trust.',
  },
  {
    title: 'Answer',
    desc: 'Answer grouped questions about your trust — name, parties, governing state — with guidance beside each field.',
  },
  {
    title: 'Review',
    desc: 'See every choice in a structured summary and edit before you save.',
  },
  {
    title: 'Download',
    desc: 'Generate a completed PDF locally and save or print it — nothing leaves your device.',
  },
];
---

<Base title="FreeTrustDocs — Free Trust Document Generator">
  <div class="ftd-tech-ribbon" aria-hidden="true"><span></span><i></i><b>FTD / DOCUMENT SYSTEM</b><i></i><span></span></div>
  <section class="section hero-section">
    <div class="container-narrow">
      <div class="hero-content">
        <h1>Free Trust Documents.<br />Generated in your browser.</h1>
        <p class="hero-subtitle">
          Answer a few questions. Get a completed trust document PDF.<br />
          No signup. No server-side storage. Nothing leaves your device.
        </p>

        <!-- In-hero document selector -->
        <fieldset class="doc-selector" id="doc-selector">
          <legend class="visually-hidden">Choose a document type</legend>
          <div class="doc-options">
            {documents.map((doc) => (
              <button
                class="doc-option"
                role="radio"
                aria-checked={doc.title === 'Certificate of Trust' ? 'true' : 'false'}
                data-create={doc.create}
                data-title={doc.title}
                tabindex={doc.title === 'Certificate of Trust' ? 0 : -1}
              >
                <strong class="doc-option-title">{doc.title}</strong>
                <span class="doc-option-meta">{doc.meta}</span>
              </button>
            ))}
          </div>
        </fieldset>

        <!-- Dynamic primary CTA -->
        <div class="hero-actions">
          <a href="/create/certificate-of-trust/" class="btn btn-primary btn-lg" id="hero-cta" data-analytics="homepage-primary-cta">
            Start Free Certificate of Trust
          </a>
          <a href="/best-states-for-trusts/" class="btn btn-outline">Best States for Trusts</a>
        </div>

        <p class="hero-privacy">
          Generated locally in your browser. Nothing is sent to any server.
          <strong>Your data stays on your device.</strong>
        </p>
      </div>
    </div>
  </section>

  <!-- FIRST VALUE: document preview + process spine -->
  <section class="firstvalue" aria-labelledby="firstvalue-heading">
    <div class="container">
      <div class="firstvalue-grid">
        <!-- Document preview panel -->
        <div class="preview-col">
          <p class="eyebrow">The document you&#8217;ll create</p>
          <h2 id="firstvalue-heading">Here&#8217;s what the tool builds for you</h2>
          <p class="firstvalue-note">
            A clean, signable trust document assembled from your answers — with a section counter
            and a structured summary you can review before saving.
          </p>

          <figure class="doc-preview" role="img" aria-label="Preview of the Certificate of Trust document FreeTrustDocs generates: a title, a Section 3 of 14 counter, the trust fields you fill in, and a notary block.">
            <div class="doc-sheet">
              <p class="doc-sheet-title">Certificate of Trust</p>
              <hr class="doc-sheet-rule" />
              <div class="doc-sheet-meta">
                <span>Combined Certification of Trust</span>
                <span class="section-count">Section 3 of 14</span>
              </div>
              <p class="doc-preamble">
                The undersigned trustee certifies that a trust exists and that the following
                facts are true and correct:
              </p>
              <div class="doc-field">
                <span class="doc-field-label">Trust name</span>
                <span class="doc-field-value doc-field-value--fill">[ Trust Name ]</span>
              </div>
              <div class="doc-field">
                <span class="doc-field-label">Date of trust</span>
                <span class="doc-field-line" aria-hidden="true"></span>
              </div>
              <div class="doc-field">
                <span class="doc-field-label">Settlor</span>
                <span class="doc-field-value doc-field-value--fill">[ Settlor Name ]</span>
              </div>
              <div class="doc-field">
                <span class="doc-field-label">Trustee</span>
                <span class="doc-field-value doc-field-value--fill">[ Trustee Name ]</span>
              </div>
              <div class="doc-field">
                <span class="doc-field-label">Governing state</span>
                <span class="doc-field-value doc-field-value--fill">[ State ]</span>
              </div>
              <div class="doc-field">
                <span class="doc-field-label">Trustee authority</span>
                <span class="doc-field-line" aria-hidden="true"></span>
              </div>
              <hr class="doc-sheet-rule" />
              <div class="doc-notary">
                <span class="doc-notary-label">Notary Public</span>
                <span class="doc-notary-line" aria-hidden="true"></span>
              </div>
            </div>
            <figcaption class="doc-preview-caption">
              Your answers fill each section as you move through the wizard.
            </figcaption>
          </figure>
        </div>

        <!-- Process spine -->
        <div class="process-col">
          <p class="eyebrow">How it works</p>
          <h2>From choice to download in one continuous flow</h2>
          <p class="firstvalue-note">
            No detour pages and no account wall. The tool stays on-screen from the first question
            to the finished file.
          </p>

          <ol class="process-spine">
            {processSteps.map((step, i) => (
              <>
                {i > 0 && (
                  <li class="process-arrow" aria-hidden="true">
                    <svg viewBox="0 0 44 10" width="44" height="10" xmlns="http://www.w3.org/2000/svg">
                      <line x1="0" y1="5" x2="40" y2="5" stroke="#8b6914" stroke-width="1.5" />
                      <polygon points="40,5 34,1.6 34,8.4" fill="#8b6914" />
                    </svg>
                  </li>
                )}
                <li class="process-step">
                  <span class="process-num">{i + 1}</span>
                  <div class="process-body">
                    <h4 class="process-title">{step.title}</h4>
                    <p class="process-desc">{step.desc}</p>
                  </div>
                </li>
              </>
            ))}
          </ol>

          <div class="callout callout-tip privacy-callout">
            <p class="callout-label">Private by design</p>
            <p>
              No signup. The PDF is generated client-side in your browser — no accounts,
              no databases, and nothing sent to any server.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Available documents (SEO) -->
  <section class="section-tight docs-section">
    <div class="container">
      <h2 style="text-align: center; margin-bottom: 2.5rem;">Available Trust Documents</h2>
      <div class="doc-grid">
        {documents.map((doc) => (
          <div class="doc-card">
            <h3>{doc.title}</h3>
            <div class="doc-meta">{doc.meta}</div>
            <p>{doc.description}</p>
            {doc.status === 'available' ? (
              <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
                <a href={doc.create} class="btn btn-primary">Create Now</a>
                <a href={doc.href} class="btn btn-outline">Learn More</a>
              </div>
            ) : (
              <span style="font-size: 0.85rem; color: var(--color-text-muted);">Coming soon</span>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Trust system + privacy: concise structured panels -->
  <section class="section-tight trust-panels">
    <div class="container">
      <div class="trust-panels-grid">
        <div class="trust-panel">
          <h3>State-Specific</h3>
          <p>
            Every state has different trust laws. We research each state&#8217;s statutes, execution
            requirements, and notary rules — then generate pages with real, state-specific information.
          </p>
          <a href="/certificate-of-trust/all-states/">Browse all states &rarr;</a>
        </div>
        <div class="trust-panel">
          <h3>Private by Design</h3>
          <p>
            Your answers never leave your browser. The PDF is generated client-side using pdfmake.
            No accounts, no databases, no tracking your personal information.
          </p>
        </div>
        <div class="trust-panel">
          <h3>Part of a Trust System</h3>
          <p>
            FreeTrustDocs creates your trust. <a href="https://trustminutes.app?utm_source=freetrustdocs&amp;utm_medium=referral&amp;utm_campaign=funnel&amp;utm_content=homepage">TrustMinutes</a> helps you maintain records.
            <a href="https://trustoffice.app?utm_source=freetrustdocs&amp;utm_medium=referral&amp;utm_campaign=funnel&amp;utm_content=homepage">TrustOffice</a> helps you govern it.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- UPL disclaimer -->
  <section class="section-tight">
    <div class="container-narrow">
      <div class="upl-notice">
        <strong>Not a law firm.</strong>
        FreeTrustDocs.com is not a law firm and does not provide legal advice.
        The documents generated by this site are for informational purposes only.
        You should consult a licensed attorney in your jurisdiction before signing or filing any legal document.
        Use of this site does not create an attorney-client relationship.
      </div>
    </div>
  </section>
</Base>

<script>
  (function () {
    var selector = document.getElementById('doc-selector');
    var cta = document.getElementById('hero-cta');
    if (!selector || !cta) return;

    var options = selector.querySelectorAll('.doc-option');

    function select(option) {
      options.forEach(function (o) {
        o.setAttribute('aria-checked', 'false');
        o.setAttribute('tabindex', '-1');
        o.classList.remove('doc-option--selected');
      });
      option.setAttribute('aria-checked', 'true');
      option.setAttribute('tabindex', '0');
      option.classList.add('doc-option--selected');

      var createHref = option.getAttribute('data-create');
      var title = option.getAttribute('data-title');
      cta.href = createHref;
      cta.textContent = 'Start ' + title;
    }

    options.forEach(function (option) {
      option.addEventListener('click', function () {
        select(option);
      });
    });

    // Keyboard arrow navigation within the radio group
    selector.addEventListener('keydown', function (e) {
      var current = selector.querySelector('.doc-option--selected');
      var list = Array.from(options);
      var idx = list.indexOf(current);

      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        e.preventDefault();
        var next = list[(idx + 1) % list.length];
        select(next);
        next.focus();
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        e.preventDefault();
        var prev = list[(idx - 1 + list.length) % list.length];
        select(prev);
        prev.focus();
      } else if (e.key === ' ') {
        e.preventDefault();
        if (current) select(current);
      }
    });

    // Default: ensure Certificate of Trust is selected on load
    var defaultOption = selector.querySelector('[data-create="/create/certificate-of-trust/"]');
    if (defaultOption) select(defaultOption);
  })();
</script>
