---
import Base from '../layouts/Base.astro';

// Active documents for the interactive outcome gallery.
// Land Trust is intentionally NOT in the active selector — it is "coming soon"
// and appears only in the SEO footer grid below. The gallery shows the outcome
// a visitor can actually get today.
const documents = [
  {
    key: 'certificate',
    title: 'Certificate of Trust',
    kicker: 'Prove the trust · certify the trustee',
    create: '/create/certificate-of-trust/',
    guide: '/certificate-of-trust/',
    meta: '5-minute wizard · 14-section PDF · UTC §1013',
    outcome: 'The one-page summary banks, title companies, and financial institutions ask for to prove a trust exists and that the trustee is authorized to act — without disclosing the full trust agreement.',
    cta: 'Start Free Certificate of Trust',
    beforeHeadline: 'Answer what the institution needs to know',
    before: ['Trust name', 'Date executed', 'Settlor(s)', 'Trustee & address', 'Governing state'],
    sheetTitle: 'Certificate of Trust',
    sheetSub: 'Combined Certification of Trust',
    sheetCount: 'Section 3 of 14',
    sheetPreamble: 'The undersigned trustee certifies that a trust exists and that the following facts are true and correct:',
    fields: [
      { label: 'Trust name', fill: true },
      { label: 'Date of trust', line: true },
      { label: 'Settlor', fill: true },
      { label: 'Trustee', fill: true },
      { label: 'Governing state', fill: true },
      { label: 'Trustee authority', line: true },
    ],
    anatomy: [
      { label: 'Trust name', note: 'Identifies the trust for the institution' },
      { label: 'Certifying language', note: 'States the trust exists and the facts are true' },
      { label: 'Trustee authority', note: 'Confirms who may act and how' },
      { label: 'Signature & notary', note: 'Signed by the trustee before a notary' },
      { label: 'UPL note', note: 'Documents are informational, not legal advice' },
    ],
  },
  {
    key: 'declaration',
    title: 'Declaration of Trust',
    kicker: 'Create the trust · write the agreement',
    create: '/create/declaration-of-trust/',
    guide: '/declaration-of-trust/',
    meta: '8-question wizard · 15-section PDF · Business trust',
    outcome: 'The full trust agreement that names the settlor, trustee, and beneficiaries and states how the trust is run, funded, and governed — assembled into a clean 15-section PDF.',
    cta: 'Start Free Declaration of Trust',
    beforeHeadline: 'Answer who the trust is for and how it runs',
    before: ['Trust name', 'Settlor & address', 'Trustee & address', 'Beneficiaries', 'Governing state'],
    sheetTitle: 'Declaration of Trust',
    sheetSub: 'Private Contract Trust Agreement',
    sheetCount: 'Article I of XV',
    sheetPreamble: 'This Declaration of Trust is made and entered into by the undersigned settlor and trustee:',
    fields: [
      { label: 'Trust name', fill: true },
      { label: 'Settlor', fill: true },
      { label: 'Trustee', fill: true },
      { label: 'Beneficiary', line: true },
      { label: 'Governing state', fill: true },
      { label: 'Duration', line: true },
    ],
    anatomy: [
      { label: 'Trust name', note: 'Names the trust and its stated purpose' },
      { label: 'Preamble', note: 'Records the date and the parties' },
      { label: 'Articles', note: 'Govern property, powers, and beneficiaries' },
      { label: 'Governing law', note: 'Selects the state law that governs' },
      { label: 'Signature & notary', note: 'Executed by settlor and trustee' },
    ],
  },
];

const landDoc = {
  title: 'Land Trust',
  href: '/land-trust/',
  description: 'Hold real property in a trust for privacy and probate avoidance. The trustee\u2019s name appears on public records; the beneficiary\u2019s stays private.',
  meta: '7-question wizard · 15-section PDF · IL, FL, and recognizing states',
};

const flowSteps = [
  { title: 'Answer', desc: 'Answer grouped questions — name, parties, governing state — with guidance beside each field.' },
  { title: 'Review', desc: 'See every choice in a structured summary and edit before you save.' },
  { title: 'Assemble', desc: 'The tool builds a completed document locally from your answers.' },
  { title: 'Download', desc: 'Save or print the PDF — nothing leaves your device.' },
];

const trustPanels = [
  {
    title: 'State-Specific',
    body: 'Every state has different trust laws. We research each state\u2019s statutes, execution requirements, and notary rules — then generate pages with real, state-specific information.',
    link: { href: '/certificate-of-trust/all-states/', text: 'Browse all states \u2192' },
  },
  {
    title: 'Private by Design',
    body: 'Your answers never leave your browser. The PDF is generated client-side using pdfmake. No accounts, no databases, no tracking your personal information.',
    link: null,
  },
  {
    title: 'Part of a Trust System',
    body: 'FreeTrustDocs creates your trust. ',
    links: [
      { href: 'https://trustminutes.app?utm_source=freetrustdocs&utm_medium=referral&utm_campaign=funnel&utm_content=homepage', text: 'TrustMinutes', after: ' helps you maintain records. ' },
      { href: 'https://trustoffice.app?utm_source=freetrustdocs&utm_medium=referral&utm_campaign=funnel&utm_content=homepage', text: 'TrustOffice', after: ' helps you govern it.' },
    ],
  },
];

const defaultKey = 'certificate';
---
<Base title="FreeTrustDocs — Free Trust Document Generator" description="Generate a finished trust document PDF in your browser. Certificate of Trust and Declaration of Trust, free. No signup. Nothing leaves your device.">
  <style>
    /* Compact hero so primary CTA is visible without scrolling */
    .hero-section { padding-top: var(--space-xl, 2rem); padding-bottom: var(--space-xl, 2rem); }
    .hero-gallery { margin-bottom: var(--space-md, 1rem); }
    .gallery-card { padding: var(--space-sm, 0.75rem) var(--space-md, 1rem); }
    .gallery-card-sheet { padding: var(--space-xs, 0.5rem) var(--space-sm, 0.75rem); }
    .gallery-card-title { font-size: 1.1rem; }
    .hero-actions { margin-bottom: var(--space-md, 1rem); }
    @media (max-width: 768px) {
      .hero-section { padding-top: var(--space-lg, 1.5rem); }
    }
  </style>
  <div class="ftd-tech-ribbon" aria-hidden="true"><span></span><i></i><b>FTD / DOCUMENT SYSTEM</b><i></i><span></span></div>

  <!-- HERO: outcome-led headline + active document gallery -->
  <section class="section hero-section">
    <div class="container-narrow">
      <div class="hero-content">
        <h1>The trust document you need,<br />finished in your browser.</h1>
        <p class="hero-subtitle">
          Answer a few questions and get a completed, signable trust document PDF.<br />
          No signup. No server-side storage. Nothing leaves your device.
        </p>

        <!-- Dynamic primary CTA (updates with gallery selection) — above gallery for above-the-fold visibility -->
        <div class="hero-actions">
          <a href={documents[0].create} class="btn btn-primary btn-lg" id="hero-cta" data-analytics="homepage-primary-cta">{documents[0].cta}</a>
          <a href="#showcase-heading" class="btn btn-outline btn-lg">See how it works</a>
        </div>

        <!-- Certificate / Declaration gallery (active selector) -->
        <div class="hero-gallery" id="doc-selector" role="radiogroup" aria-label="Choose a document">
          {documents.map((doc, i) => (
            <button
              class:list={['gallery-card', doc.key === defaultKey ? 'gallery-card--selected' : '']}
              role="radio"
              aria-checked={doc.key === defaultKey ? 'true' : 'false'}
              aria-label={`${doc.title} document`}
              data-doc={doc.key}
              data-create={doc.create}
              data-title={doc.title}
              data-cta={doc.cta}
              tabindex={doc.key === defaultKey ? 0 : -1}
            >
              <span class="gallery-card-top">
                <span class="gallery-kicker">{doc.kicker}</span>
                <span class="gallery-card-title">{doc.title}</span>
              </span>
              <span class="gallery-card-sheet">
                <span class="gallery-sheet-title">{doc.sheetTitle}</span>
                <span class="gallery-sheet-rule" aria-hidden="true"></span>
                <span class="doc-field"><span class="doc-field-label">Trust name</span><span class="doc-field-value">[ Trust Name ]</span></span>
                <span class="doc-field"><span class="doc-field-label">Trustee</span><span class="doc-field-value">[ Trustee Name ]</span></span>
              </span>
              <span class="gallery-card-meta">{doc.meta}</span>
            </button>
          ))}
          <p class="gallery-coming-soon">
            Looking for a <a href="/land-trust/">Land Trust</a>? It&rsquo;s in development —
            coming soon.
          </p>
        </div>

        <p class="hero-privacy">
          Generated locally in your browser. Nothing is sent to any server.
          <strong>Your data stays on your device.</strong>
        </p>
      </div>
    </div>
  </section>

  <!-- OUTCOME SHOWCASE: live before → after transformation + anatomy -->
  <section class="section showcase" aria-labelledby="showcase-heading">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Your outcome</p>
        <h2 id="showcase-heading">From answers to a finished document</h2>
        <p class="section-lede">
          Pick a document above. The tool turns the questions you answer into a clean,
          signable PDF — reviewed section by section before you save.
        </p>
      </div>

      {documents.map((doc) => (
        <div class:list={['showcase-panel', doc.key === defaultKey ? 'showcase-panel--active' : '']} data-doc-showcase={doc.key} hidden={doc.key !== defaultKey}>
          <!-- Before → After transformation -->
          <div class="transform-grid">
            <div class="transform-panel">
              <p class="transform-tag transform-tag--before">Before · your answers</p>
              <h3 class="transform-title">{doc.beforeHeadline}</h3>
              <div class="question-list">
                {doc.before.map((q) => (
                  <div class="question-row">
                    <span class="question-label">{q}</span>
                    <span class="question-input">[ Your answer ]</span>
                  </div>
                ))}
              </div>
            </div>

            <div class="transform-arrow" aria-hidden="true">&#8594;</div>

            <div class="transform-panel">
              <p class="transform-tag transform-tag--after">After · the completed PDF</p>
              <figure class="doc-preview doc-preview--showcase" role="img" aria-label={`Preview of the ${doc.sheetTitle} FreeTrustDocs generates: a title, a ${doc.sheetCount} counter, the trust fields you fill in, and a notary block.`}>
                <div class="doc-sheet">
                  <p class="doc-sheet-title">{doc.sheetTitle}</p>
                  <hr class="doc-sheet-rule" />
                  <div class="doc-sheet-meta">
                    <span>{doc.sheetSub}</span>
                    <span class="section-count">{doc.sheetCount}</span>
                  </div>
                  <p class="doc-preamble">{doc.sheetPreamble}</p>
                  {doc.fields.map((f) => (
                    f.line ? (
                      <div class="doc-field">
                        <span class="doc-field-label">{f.label}</span>
                        <span class="doc-field-line" aria-hidden="true"></span>
                      </div>
                    ) : (
                      <div class="doc-field">
                        <span class="doc-field-label">{f.label}</span>
                        <span class="doc-field-value doc-field-value--fill">[ {f.label} ]</span>
                      </div>
                    )
                  ))}
                  <hr class="doc-sheet-rule" />
                  <div class="doc-notary">
                    <span class="doc-notary-label">Notary Public</span>
                    <span class="doc-notary-line" aria-hidden="true"></span>
                  </div>
                </div>
                <figcaption class="doc-preview-caption">
                  Your answers fill each section as you move through the wizard.
                </figcaption>
              </figure>
            </div>
          </div>

          <!-- Anatomy -->
          <div class="anatomy">
            <p class="eyebrow">Anatomy of the document</p>
            <h3>What&rsquo;s in it, and why it matters</h3>
            <ol class="anatomy-list">
              {doc.anatomy.map((a) => (
                <li class="anatomy-item">
                  <strong class="anatomy-label">{a.label}</strong>
                  <span class="anatomy-note">{a.note}</span>
                </li>
              ))}
            </ol>
          </div>

          <!-- Proof CTA per doc -->
          <div class="proof-cta">
            <div class="proof-cta-copy">
              <p class="eyebrow">Proof, ready when you need it</p>
              <h3>{doc.key === 'certificate' ? 'Show the institution the trustee is authorized to act.' : 'Hold a complete, structured trust agreement in hand.'}</h3>
              <p class="proof-cta-body">
                Generate the document in-browser, review it, download it — free, with no account.{' '}
                {doc.key === 'certificate' ? 'Banks and title companies accept a Certificate of Trust in place of the full agreement.' : 'Keep the original trust agreement private and signable on demand.'}
              </p>
            </div>
            <div class="proof-cta-actions">
              <a href={doc.create} class="btn btn-primary btn-lg">{doc.cta}</a>
              <a href={doc.guide} class="btn btn-outline btn-lg">Learn more</a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- DOCUMENT NETWORK: a visual explanation of the product relationships -->
  <section class="section network-section" aria-labelledby="network-heading">
    <div class="container">
      <div class="network-layout">
        <div class="network-copy">
          <p class="eyebrow">The document system</p>
          <h2 id="network-heading">Every answer has a place in the finished document.</h2>
          <p>
            FreeTrustDocs connects the people, state information, and execution details that make a trust document usable — then assembles them into one file on your device.
          </p>
          <div class="network-legend" aria-label="Document network legend">
            <span><i class="network-dot network-dot--green"></i>Input</span>
            <span><i class="network-dot network-dot--bronze"></i>Document structure</span>
            <span><i class="network-dot network-dot--cream"></i>Execution</span>
          </div>
        </div>
        <figure class="network-figure" aria-label="Diagram connecting trust answers to a finished PDF">
          <svg class="network-svg" viewBox="0 0 720 300" role="img" aria-labelledby="network-svg-title network-svg-desc" xmlns="http://www.w3.org/2000/svg">
            <title id="network-svg-title">Trust document connection map</title>
            <desc id="network-svg-desc">Settlor, trustee, state, and notary details connect through the browser to a finished PDF.</desc>
            <g class="network-lines" fill="none" stroke="currentColor" stroke-width="1">
              <path d="M88 70 C180 70 198 128 284 145" />
              <path d="M88 230 C180 230 198 172 284 155" />
              <path d="M360 150 C430 150 448 80 516 80" />
              <path d="M360 150 C430 150 448 220 516 220" />
              <path d="M548 80 C602 80 610 120 642 140" />
              <path d="M548 220 C602 220 610 180 642 160" />
            </g>
            <g class="network-nodes">
              <g class="network-node network-node--input"><circle cx="72" cy="70" r="9"/><text x="72" y="43" text-anchor="middle">SETTLOR</text></g>
              <g class="network-node network-node--input"><circle cx="72" cy="230" r="9"/><text x="72" y="267" text-anchor="middle">TRUSTEE</text></g>
              <g class="network-node network-node--core"><circle cx="320" cy="150" r="20"/><circle cx="320" cy="150" r="27" class="network-ring"/><text x="320" y="155" text-anchor="middle">TRUST</text></g>
              <g class="network-node network-node--structure"><circle cx="532" cy="80" r="9"/><text x="532" y="48" text-anchor="middle">STATE</text></g>
              <g class="network-node network-node--structure"><circle cx="532" cy="220" r="9"/><text x="532" y="258" text-anchor="middle">NOTARY</text></g>
              <g class="network-node network-node--output"><rect x="642" y="124" width="52" height="52" rx="2"/><path d="M654 140h28M654 149h28M654 158h18"/><text x="668" y="204" text-anchor="middle">PDF</text></g>
            </g>
            <g class="network-register" aria-hidden="true"><path d="M20 18h18M20 18v18M700 18h-18M700 18v18M20 282h18M20 282v-18M700 282h-18M700 282v-18"/><circle cx="360" cy="18" r="2"/><circle cx="360" cy="282" r="2"/></g>
          </svg>
          <figcaption>Structured inputs → browser assembly → finished PDF</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- PRIVACY FLOW -->
  <section class="section-tight privacy-flow" aria-labelledby="privacy-heading">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Private by design</p>
        <h2 id="privacy-heading">The whole flow stays on your device</h2>
      </div>
      <ol class="flow">
        {flowSteps.map((step, i) => (
          <li class="flow-step">
            <div class="flow-marker"><span class="process-num">{i + 1}</span><span class="process-rule" aria-hidden="true"></span></div>
            <div class="flow-body">
              <h4>{step.title}</h4>
              <p>{step.desc}</p>
            </div>
          </li>
        ))}
      </ol>
      <div class="callout callout-tip privacy-callout">
        <p class="callout-label">No signup · no server</p>
        <p>
          The PDF is generated client-side in your browser — no accounts, no databases,
          and nothing sent to any server.
        </p>
      </div>
    </div>
  </section>

  <!-- Trust system panels -->
  <section class="section-tight trust-panels">
    <div class="container">
      <div class="trust-panels-grid">
        {trustPanels.map((p) => (
          <div class="trust-panel">
            <h3>{p.title}</h3>
            <p>
              {p.body}
              {p.link && (<a href={p.link.href}>{p.link.text}</a>)}
              {p.links && p.links.map((l) => (
                <span><a href={l.href}>{l.text}</a>{l.after}</span>
              ))}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- UPL disclaimer -->
  <section class="section-tight">
    <div class="container-narrow">
      <div class="upl-notice">
        <strong>Not a law firm.</strong>
        FreeTrustDocs.com is not a law firm and does not provide legal advice.
        The documents generated by this site are for informational purposes only.
        You should consult a licensed attorney in your jurisdiction before signing or filing any legal document.
        Use of this site does not create an attorney-client relationship.
      </div>
    </div>
  </section>
</Base>

<script>
  (function () {
    var selector = document.getElementById('doc-selector');
    var cta = document.getElementById('hero-cta');
    if (!selector || !cta) return;

    var cards = Array.from(selector.querySelectorAll('.gallery-card'));
    var panels = Array.from(document.querySelectorAll('[data-doc-showcase]'));
    var defaultKey = 'certificate';

    function select(card) {
      cards.forEach(function (c) {
        c.setAttribute('aria-checked', 'false');
        c.setAttribute('tabindex', '-1');
        c.classList.remove('gallery-card--selected');
      });
      card.setAttribute('aria-checked', 'true');
      card.setAttribute('tabindex', '0');
      card.classList.add('gallery-card--selected');

      var key = card.getAttribute('data-doc');
      panels.forEach(function (p) {
        var active = p.getAttribute('data-doc-showcase') === key;
        p.hidden = !active;
        if (active) p.classList.add('showcase-panel--active');
        else p.classList.remove('showcase-panel--active');
      });

      cta.href = card.getAttribute('data-create');
      cta.textContent = card.getAttribute('data-cta');
    }

    cards.forEach(function (card) {
      card.addEventListener('click', function () { select(card); });
    });

    selector.addEventListener('keydown', function (e) {
      var current = selector.querySelector('.gallery-card--selected') || cards[0];
      var idx = cards.indexOf(current);
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        e.preventDefault();
        var next = cards[(idx + 1) % cards.length];
        select(next); next.focus();
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        e.preventDefault();
        var prev = cards[(idx - 1 + cards.length) % cards.length];
        select(prev); prev.focus();
      } else if (e.key === ' ') {
        e.preventDefault();
        select(current);
      }
    });

    // Default to Certificate of Trust on load
    var defaultCard = cards.find ? cards.find(function (c) { return c.getAttribute('data-doc') === defaultKey; }) : cards[0];
    if (defaultCard) select(defaultCard);
  })();
</script>
