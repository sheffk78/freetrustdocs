---
import Base from '../../layouts/Base.astro';
import CertOfTrustWizard from '../../components/CertOfTrustWizard.tsx';

const title = 'Create Certificate of Trust — Free Online Wizard';
const description = 'Generate a Certificate of Trust online for free. Answer 8 questions, get a completed PDF. No signup. Nothing leaves your browser. UTC §1013-style.';

const legalServiceSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "applicationCategory": "LegalApplication",
  "operatingSystem": "Web",
  "browserRequirements": "Requires JavaScript",
  "name": "FreeTrustDocs Certificate of Trust Generator",
  "description": "Free online Certificate of Trust generator. No signup required.",
  "url": "https://freetrustdocs.com/create/certificate-of-trust/",
  "publisher": {"@id": "https://freetrustdocs.com/#organization"},
  "areaServed": "US",
  "offers": {"@type": "Offer", "price": "0", "priceCurrency": "USD"}
};
---

<Base title={title} description={description}>
  <section class="section">
    <div class="container">
      <div class="breadcrumbs">
        <a href="/">Home</a> <span>›</span>
        <a href="/certificate-of-trust/">Certificate of Trust</a> <span>›</span> Create
      </div>

      <h1>Create Certificate of Trust</h1>
      <p style="color: var(--color-text-muted); margin-bottom: 2rem;">
        Answer the questions below. Your answers stay in your browser — no data is sent to any server.
        When you're done, you'll get a completed Certificate of Trust PDF.
      </p>

      <CertOfTrustWizard client:load />

      <div class="sidebar-card">
        <strong>After creating your Certificate of Trust:</strong>
        Keep your trust records organized with
        <a href="https://trustminutes.app?utm_source=freetrustdocs&utm_medium=referral&utm_campaign=funnel&utm_content=wizard_sidebar&utm_term=certificate_of_trust">
          TrustMinutes
        </a> (free). Then govern it with
        <a href="https://trustoffice.app?utm_source=freetrustdocs&utm_medium=referral&utm_campaign=funnel&utm_content=wizard_sidebar&utm_term=certificate_of_trust">
          TrustOffice
        </a>.

  <section class="section-tight" style="margin-top: 3rem;">
    <div class="container-narrow">
      <h2>What a certificate of trust does</h2>
      <p>A certificate of trust is a short summary of a living trust that banks, title companies, and brokerages accept instead of the full trust agreement. It confirms the trust exists, names the current trustees, and lists the powers trustees can exercise — without revealing your beneficiaries, distribution rules, or assets. Nearly every state recognizes it by statute, and third parties generally must accept it in place of the full document.</p>

      <h2>What this generator produces</h2>
      <ul>
        <li>A state-specific Certificate of Trust following your state's statutory content requirements</li>
        <li>Trustee names, powers, and revocability status as required by statute</li>
        <li>A signature block with notary acknowledgment</li>
      </ul>
      <p>The finished PDF downloads instantly and is ready to present to any institution that requests trust documentation.</p>

      <h2>State requirements at a glance</h2>
      <p>Each state's statute lists what the certificate must contain and what recipients may demand:</p>
      <ul>
        <li><a href="/certificate-of-trust/utah/">Utah</a> (§ 75B-2-1013), <a href="/certificate-of-trust/california/">California</a> (§ 18100.5), <a href="/certificate-of-trust/texas/">Texas</a> (§ 114.086)</li>
        <li><a href="/certificate-of-trust/florida/">Florida</a> (§ 736.1017), <a href="/certificate-of-trust/new-york/">New York</a> (EPTL 7-1.19), <a href="/certificate-of-trust/illinois/">Illinois</a></li>
        <li><a href="/certificate-of-trust/all-states/">All 51 state pages</a> — verified statute citations on each</li>
      </ul>

      <h2>Learn more</h2>
      <p>New to the topic? Read <a href="/guide/what-is-a-certificate-of-trust/">what a certificate of trust is</a>, how it <a href="/guide/certificate-of-trust-vs-declaration/">differs from a declaration of trust</a>, or browse the full <a href="/certificate-of-trust/">state-by-state guide</a>.</p>
    </div>
  </section>

      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(legalServiceSchema)} />
</Base>