---
import Base from '../../layouts/Base.astro';
import DeclarationOfTrustWizard from '../../components/DeclarationOfTrustWizard.tsx';

const title = 'Create Declaration of Trust — Free Online Wizard';
const description = 'Generate a Declaration of Trust (Private Contract Trust) online for free. Answer a few questions, get a completed PDF. No signup. Nothing leaves your browser.';

const legalServiceSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "applicationCategory": "LegalApplication",
  "operatingSystem": "Web",
  "browserRequirements": "Requires JavaScript",
  "name": "FreeTrustDocs Declaration of Trust Generator",
  "description": "Free online Declaration of Trust generator. No signup required.",
  "url": "https://freetrustdocs.com/create/declaration-of-trust/",
  "publisher": {"@id": "https://freetrustdocs.com/#organization"},
  "areaServed": "US",
  "offers": {"@type": "Offer", "price": "0", "priceCurrency": "USD"}
};
---

<Base title={title} description={description}>
  <section class="section">
    <div class="container">
      <div class="breadcrumbs">
        <a href="/">Home</a> <span>›</span>
        <a href="/declaration-of-trust/">Declaration of Trust</a> <span>›</span> Create
      </div>

      <h1>Create Declaration of Trust</h1>
      <p style="color: var(--color-text-muted); margin-bottom: 2rem;">
        Answer the questions below. Your answers stay in your browser — no data is sent to any server.
        When you're done, you'll get a completed Declaration of Trust PDF.
      </p>

      <DeclarationOfTrustWizard client:load />

      <div class="sidebar-card">
        <strong>After creating your Declaration of Trust:</strong>
        Keep your trust records organized with
        <a href="https://trustminutes.app?utm_source=freetrustdocs&utm_medium=referral&utm_campaign=funnel&utm_content=wizard_sidebar&utm_term=declaration_of_trust">
          TrustMinutes
        </a> (free). Then govern it with
        <a href="https://trustoffice.app?utm_source=freetrustdocs&utm_medium=referral&utm_campaign=funnel&utm_content=wizard_sidebar&utm_term=declaration_of_trust">
          TrustOffice
        </a>.
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(legalServiceSchema)} />
</Base>
