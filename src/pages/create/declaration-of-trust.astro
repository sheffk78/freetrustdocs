---
import Base from '../../layouts/Base.astro';
import DeclarationOfTrustWizard from '../../components/DeclarationOfTrustWizard.tsx';

const title = 'Create Declaration of Trust — Free Online Wizard';
const description = 'Generate a Declaration of Trust (Private Contract Trust) online for free. Answer a few questions, get a completed PDF. No signup. Nothing leaves your browser.';

const legalServiceSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "applicationCategory": "LegalApplication",
  "operatingSystem": "Web",
  "browserRequirements": "Requires JavaScript",
  "name": "FreeTrustDocs Declaration of Trust Generator",
  "description": "Free online Declaration of Trust generator. No signup required.",
  "url": "https://freetrustdocs.com/create/declaration-of-trust/",
  "publisher": {"@id": "https://freetrustdocs.com/#organization"},
  "areaServed": "US",
  "offers": {"@type": "Offer", "price": "0", "priceCurrency": "USD"}
};
---

<Base title={title} description={description}>
  <section class="section">
    <div class="container">
      <div class="breadcrumbs">
        <a href="/">Home</a> <span>›</span>
        <a href="/declaration-of-trust/">Declaration of Trust</a> <span>›</span> Create
      </div>

      <h1>Create Declaration of Trust</h1>
      <p style="color: var(--color-text-muted); margin-bottom: 2rem;">
        Answer the questions below. Your answers stay in your browser — no data is sent to any server.
        When you're done, you'll get a completed Declaration of Trust PDF.
      </p>

      <DeclarationOfTrustWizard client:load />

      <div class="sidebar-card">
        <strong>After creating your Declaration of Trust:</strong>
        Keep your trust records organized with
        <a href="https://trustminutes.app?utm_source=freetrustdocs&utm_medium=referral&utm_campaign=funnel&utm_content=wizard_sidebar&utm_term=declaration_of_trust">
          TrustMinutes
        </a> (free). Then govern it with
        <a href="https://trustoffice.app?utm_source=freetrustdocs&utm_medium=referral&utm_campaign=funnel&utm_content=wizard_sidebar&utm_term=declaration_of_trust">
          TrustOffice
        </a>.

  <section class="section-tight" style="margin-top: 3rem;">
    <div class="container-narrow">
      <h2>What a declaration of trust does</h2>
      <p>The declaration of trust is the founding document of a revocable living trust. It names you as grantor and trustee, lists the beneficiaries, and sets the rules for managing and distributing trust property. Because you name yourself trustee, you keep full control — you can amend or revoke the trust at any time while you're living and competent. On your death, the successor trustee you named steps in and distributes the trust property without probate.</p>

      <h2>What this generator produces</h2>
      <ul>
        <li>A complete Declaration of Trust with your chosen successor trustees and beneficiaries</li>
        <li>Revocation and amendment provisions</li>
        <li>Trustee powers, successor-trustee succession, and distribution rules</li>
        <li>A signature block with notary acknowledgment</li>
      </ul>
      <p>The finished PDF downloads instantly, ready to sign and notarize.</p>

      <h2>After you sign: fund the trust</h2>
      <p>A trust only avoids probate for property actually titled in its name. After signing, transfer assets: record a new deed for real estate, update beneficiary designations on accounts, and retitle brokerage or bank accounts. Our <a href="/guide/trust-funding-checklist/">trust funding checklist</a> walks through every asset type.</p>

      <h2>Learn more</h2>
      <p>Read <a href="/guide/what-is-a-declaration-of-trust/">what a declaration of trust is</a>, see <a href="/guide/revocable-vs-irrevocable-trust/">revocable vs. irrevocable</a> tradeoffs, or review <a href="/guide/how-to-revoke-a-trust/">how to revoke a trust</a>. For a short summary document banks accept, create a <a href="/create/certificate-of-trust/">certificate of trust</a> instead.</p>
    </div>
  </section>

      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(legalServiceSchema)} />
</Base>
